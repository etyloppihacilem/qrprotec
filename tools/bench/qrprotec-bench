# -------------------------------------------------------------------------------------------------------- disque

def disk(rep, directory, count):
    rep.section(f'Disque ({directory})')
    latencies = []
    path = Path(directory) / f'.qrprotec-bench-{os.getpid()}'
    block = os.urandom(4096)
    fd = os.open(path, os.O_WRONLY | os.O_CREAT | os.O_TRUNC, 0o600)
    try:
        for _ in range(count):
            os.write(fd, block)
            start = time.perf_counter()
            os.fdatasync(fd)
            latencies.append((time.perf_counter() - start) * 1000)
    finally:
        os.close(fd)
    p99 = pct(latencies, 99)
    rep.add('disk.fdatasync_p50_ms', pct(latencies, 50), 'fdatasync 4 Kio, mediane (ms)')
    rep.add('disk.fdatasync_p99_ms', p99, 'fdatasync 4 Kio, p99 (ms)', grade(p99, 2, 10),
            '< 2 ms : bon SSD ; > 10 ms : carte SD, eMMC ou SSD bas de gamme')
    size = 256 * 1024 * 1024
    chunk = os.urandom(1024 * 1024)
    start = time.perf_counter()
    with open(path, 'wb') as out:
        for _ in range(size // len(chunk)):
            out.write(chunk)
        out.flush()
        os.fsync(out.fileno())
    rate = size / 1e6 / (time.perf_counter() - start)
    path.unlink()
    rep.add('disk.seq_write_mb_s', rate, 'Ecriture sequentielle 256 Mo (Mo/s)', grade(rate, 200, 50, False),
            'sauvegardes, mises a jour')


# -------------------------------------------------------------------------------------------------------- SQLite

def sqlite_conn(path):
    # meme configuration que DATABASES['default']['OPTIONS'] du back (settings.py)
    conn = sqlite3.connect(path, timeout=20, isolation_level=None, check_same_thread=False)
    conn.execute('PRAGMA journal_mode=WAL')
    conn.execute('PRAGMA synchronous=NORMAL')
    return conn


def sqlite_bench(rep, directory):
    rep.section('SQLite (WAL + IMMEDIATE, comme en production)')
    tmp = Path(tempfile.mkdtemp(prefix='qrprotec-bench-', dir=directory))
    try:
        path = str(tmp / 'bench.sqlite3')
        conn = sqlite_conn(path)
        conn.execute('CREATE TABLE scan (id INTEGER PRIMARY KEY, iid TEXT, lot TEXT, at REAL, payload TEXT)')
        count = 2000
        start = time.perf_counter()
        for index in range(count):
            conn.execute('BEGIN IMMEDIATE')
            conn.execute('INSERT INTO scan (iid, lot, at, payload) VALUES (?, ?, ?, ?)',
                         (f'{index:08x}', 'lot', time.time(), 'x' * 200))
            conn.execute('COMMIT')
        rate = count / (time.perf_counter() - start)
        rep.add('sqlite.commits_s', rate, 'Commits/s (un ecrivain)', grade(rate, 2000, 300, False))
        conn.execute('PRAGMA synchronous=FULL')
        start = time.perf_counter()
        for index in range(500):
            conn.execute('BEGIN IMMEDIATE')
            conn.execute('INSERT INTO scan (iid, lot, at, payload) VALUES (?, ?, ?, ?)', ('full', 'lot', 0, ''))
            conn.execute('COMMIT')
        rep.add('sqlite.commits_full_s', 500 / (time.perf_counter() - start), 'Commits/s en synchronous=FULL',
                INFO, 'fsync a chaque commit : reflete le disque')
        conn.close()

        # 8 ecrivains concurrents, chacun une verif de 30 items par transaction (comme 8 verifs simultanees)
        latencies, errors = [], []
        lock = threading.Lock()

        def writer(number):
            local = sqlite_conn(path)
            for round_ in range(40):
                start = time.perf_counter()
                try:
                    local.execute('BEGIN IMMEDIATE')
                    local.execute('SELECT count(*) FROM scan WHERE lot = ?', (f'lot{number}',)).fetchone()
                    local.executemany('INSERT INTO scan (iid, lot, at, payload) VALUES (?, ?, ?, ?)',
                                      [(f'{number}-{round_}-{i}', f'lot{number}', time.time(), 'y' * 100)
                                       for i in range(30)])
                    local.execute('COMMIT')
                    with lock:
                        latencies.append((time.perf_counter() - start) * 1000)
                except sqlite3.OperationalError as error:
                    with lock:
                        errors.append(str(error))
                    try:
                        local.execute('ROLLBACK')
                    except sqlite3.OperationalError:
                        pass
            local.close()

        threads = [threading.Thread(target=writer, args=(n,)) for n in range(8)]
        for thread in threads:
            thread.start()
        for thread in threads:
            thread.join()
        p95 = pct(latencies, 95)
        rep.add('sqlite.contention_p95_ms', p95, '8 ecrivains simultanes, p95 (ms)', grade(p95, 50, 300))
        rep.add('sqlite.contention_errors', len(errors), 'Erreurs « database is locked »',
                OK if not errors else BAD)

        conn = sqlite_conn(path)
        conn.execute('BEGIN')
        conn.executemany('INSERT INTO scan (iid, lot, at, payload) VALUES (?, ?, ?, ?)',
                         ((f'v{i}', f'lot{i % 50}', 0, 'z' * 300) for i in range(150000)))
        conn.execute('COMMIT')
        conn.execute('DELETE FROM scan WHERE id % 2 = 0')
        start = time.perf_counter()
        conn.execute('VACUUM')
        rep.add('sqlite.vacuum_s', time.perf_counter() - start, 'VACUUM d\'une base de ~50 Mo (s)', INFO)
        conn.close()
    finally:
        shutil.rmtree(tmp, ignore_errors=True)


# ----------------------------------------------------------------------------------------------------------- CPU

def cpu_task(_=None):
    """Travail type d'une requete Django (dicts, JSON, regex, tri), en pur Python : un seul coeur."""
    start = time.perf_counter()
    pattern = re.compile(r'([a-z]{6})-(\d{4})')
    for round_ in range(6):
        rows = [{'iid': f'{i:08x}', 'type': f'compre-{i % 9999:04d}', 'lot': i % 50, 'qty': i % 7,
                 'name': 'Compresses stériles 10×10'} for i in range(20000)]
        text = json.dumps(rows)
        rows = json.loads(text)
        rows.sort(key=lambda row: (row['lot'], row['type'], row['iid']))
        groups = {}
        for row in rows:
            match = pattern.match(row['type'])
            groups.setdefault((row['lot'], match.group(1)), []).append(row['qty'])
        sum(sum(values) for values in groups.values())
    return (time.perf_counter() - start) * 1000


def cpu(rep):
    rep.section('CPU (Python, comme Django)')
    single = min(cpu_task() for _ in range(3))
    rep.add('cpu.single_ms', single, 'Un coeur, meilleur de 3 (ms)', grade(single, 1500, 4000),
            'plus petit = mieux ; compte le plus (GIL)')
    workers = os.cpu_count() or 1
    with ProcessPoolExecutor(workers) as pool:
        results = list(pool.map(cpu_task, range(workers * 2)))
    allcores = statistics.median(results)
    rep.add('cpu.all_cores_ms', allcores, f'Tous les coeurs ({workers}), mediane (ms)', INFO,
            f'{allcores / single:.2f}× le temps sur un coeur : turbo perdu sous charge')


CPU_SENSORS = ('k10temp', 'zenpower', 'coretemp', 'cpu_thermal', 'soc_thermal')


def temperatures():
    """Temperature du processeur (°C) : capteurs du CPU en priorite (k10temp, coretemp...), sinon tous ; les valeurs
    impossibles (capteur absent ou mal lu, ex. 179 °C) sont ignorees."""
    cpu, other = [], []
    for sensor in Path('/sys/class/hwmon').glob('hwmon*/temp*_input'):
        value = read(sensor)
        if value.isdigit() and 1000 <= int(value) <= 125000:
            (cpu if read(sensor.parent / 'name') in CPU_SENSORS else other).append(int(value) / 1000)
    for zone in Path('/sys/class/thermal').glob('thermal_zone*'):
        value = read(zone / 'temp')
        if value.isdigit() and 1000 <= int(value) <= 125000:
            (cpu if 'cpu' in read(zone / 'type').lower() or read(zone / 'type') == 'x86_pkg_temp' else other).append(
                int(value) / 1000)
    temps = cpu or other
    return max(temps) if temps else None


def endurance(rep, minutes):
    rep.section(f'Chauffe ({minutes:g} min de charge sur tous les coeurs)')
    stop = time.monotonic() + minutes * 60
    workers = max(1, (os.cpu_count() or 1) - 1)  # un coeur garde pour la mesure
    first, scores, hottest = None, [], 0
    with ProcessPoolExecutor(workers) as pool:
        while time.monotonic() < stop:
            futures = [pool.submit(cpu_task) for _ in range(workers)]
            score = cpu_task()
            for future in futures:
                future.result()
            first = first or score
            scores.append(score)
            temp = temperatures()
            hottest = max(hottest, temp or 0)
            remaining = int(stop - time.monotonic())
            if sys.stdout.isatty():
                print(f'      {score:7.0f} ms   {temp or 0:5.1f} °C   reste {remaining // 60:2d} min {remaining % 60:02d}',
                      end='\r', flush=True)
    if sys.stdout.isatty():
        print()
    last = statistics.median(scores[-5:])
    slowdown = (last / first - 1) * 100
    rep.add('endurance.slowdown_pct', slowdown, 'Ralentissement fin / debut (%)', grade(slowdown, 10, 25),
            'refroidissement insuffisant si eleve')
    rep.add('endurance.max_temp_c', hottest or None, 'Temperature max (°C)', grade(hottest, 80, 92) if hottest else INFO)


