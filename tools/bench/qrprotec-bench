def django_ok(python, vendor=None):
    env = dict(os.environ, PYTHONPATH=str(vendor)) if vendor else None
    try:
        return subprocess.run([python, '-c', 'import django, rest_framework, cryptography'], env=env,
                              capture_output=True, timeout=30).returncode == 0
    except OSError:
        return False


def find_backend():
    """(dossier du back, vendor/ ou None, python qui a Django) : depot (Python courant, .venv de poetry, `poetry env`),
    sinon back du RPM avec ses dependances figees. (None, None, message) si rien ne convient."""
    repo = Path(__file__).resolve().parent.parent.parent
    if (repo / 'database' / 'manage.py').exists():
        pythons = [sys.executable, str(repo / '.venv' / 'bin' / 'python')]
        if shutil.which('poetry'):
            code, out = run(['poetry', '-C', str(repo), 'env', 'info', '--executable'])
            if code == 0 and out.strip():
                pythons.append(out.strip().splitlines()[-1])
        for python in dict.fromkeys(pythons):
            if Path(python).exists() and django_ok(python):
                return repo / 'database', None, python
    rpm = Path('/usr/share/qrprotec')
    if (rpm / 'backend' / 'manage.py').exists() and django_ok('/usr/bin/python3', rpm / 'vendor'):
        return rpm / 'backend', rpm / 'vendor', '/usr/bin/python3'
    return None, None, ('Django (ou cryptography) introuvable : lancer `poetry install --no-root --with push` a la '
                        'racine du depot, ou installer le RPM qrprotec')


def free_port():
    with socket.socket() as sock:
        sock.bind(('127.0.0.1', 0))
        return sock.getsockname()[1]


