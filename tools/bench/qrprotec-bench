    parser.add_argument('--json', help='enregistre les resultats (pour --compare)')
    parser.add_argument('--keep', action='store_true', help='garde le dossier de test du back')
    parser.add_argument('--compare', nargs='+', metavar='JSON', help='compare des resultats enregistres')
    args = parser.parse_args()

    if args.compare:
        compare(args.compare)
        return 0
    if args.dir is None:
        # /var/tmp plutot que /tmp : sous Fedora /tmp est en memoire (tmpfs), le disque ne serait pas mesure
        args.dir = '/var/lib/qrprotec' if os.access('/var/lib/qrprotec', os.W_OK) else '/var/tmp'
    only = set(args.only.split(',')) if args.only else {'machine', 'bluetooth', 'kiosk', 'disk', 'sqlite', 'cpu', 'app'}
    if args.endurance:
