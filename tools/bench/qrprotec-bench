def find_backend(option):
    here = Path(__file__).resolve().parent
    candidates = [Path(option)] if option else [here.parent.parent / 'database', Path('/usr/share/qrprotec/backend')]
    for backend in candidates:
        if (backend / 'manage.py').exists():
            vendor = backend.parent / 'vendor'
            return backend, (vendor if vendor.is_dir() else None)
    return None, None


def free_port():
    with socket.socket() as sock:
        sock.bind(('127.0.0.1', 0))
        return sock.getsockname()[1]


