def bluetooth(rep, scan_seconds):
    rep.section('Bluetooth (douchette Inateck, BLE)')
    adapters = sorted(p for p in Path('/sys/class/bluetooth').glob('hci*') if ':' not in p.name)
    rep.add('bluetooth.adapter', bool(adapters), 'Adaptateur Bluetooth present', OK if adapters else BAD,
            ', '.join(p.name for p in adapters) if adapters else 'aucun : la douchette ne pourra pas se connecter')
    for adapter in adapters:
        device = adapter / 'device'
        driver = os.path.basename(os.path.realpath(device / 'driver')) if (device / 'driver').exists() else '?'
        modalias = read(device / 'modalias')
        usb = re.search(r'usb:v([0-9A-F]{4})p([0-9A-F]{4})', modalias)
        bus = f'USB {usb.group(1).lower()}:{usb.group(2).lower()}' if usb else modalias.split(':')[0] or '?'
        rep.add(None, f'{driver}, {bus}', f'  {adapter.name} : pilote')
    blocked = []
    for rfkill in Path('/sys/class/rfkill').glob('rfkill*'):
        if read(rfkill / 'type') == 'bluetooth':
            if read(rfkill / 'hard') == '1':
                blocked.append(f'{read(rfkill / "name")} bloque materiellement (interrupteur/BIOS)')
            elif read(rfkill / 'soft') == '1':
                blocked.append(f'{read(rfkill / "name")} bloque (rfkill unblock bluetooth)')
    if adapters:
        rep.add('bluetooth.rfkill_ok', not blocked, 'Non bloque (rfkill)', BAD if blocked else OK, '; '.join(blocked))
    code, out = run(['systemctl', 'is-active', 'bluetooth'])
    active = out.strip() == 'active'
    rep.add('bluetooth.bluetoothd', active, 'Service bluetooth (BlueZ) actif', OK if active else BAD,
            '' if active else 'sudo systemctl enable --now bluetooth')
    code, out = run(['bluetoothctl', '--version'])
    if code == 0:
        rep.add('bluetooth.bluez', out.strip().split()[-1], 'Version de BlueZ')
    if not adapters:
        rep.values['bluetooth.le'] = False
        return
    le = powered = None
    code, out = run(['btmgmt', '--index', adapters[0].name[3:], 'info'])
    supported = re.search(r'supported settings:(.*)', out or '')
    if code == 0 and supported:
        le = ' le' in f' {supported.group(1)} '
        current = re.search(r'current settings:(.*)', out)
        powered = bool(current and 'powered' in current.group(1))
        version = re.search(r'version (\d+)', out)
        if version:
            # 6 = Bluetooth 4.0 (premier avec le BLE) ; 9 = 5.0 (portee et debit meilleurs)
            names = {6: '4.0', 7: '4.1', 8: '4.2', 9: '5.0', 10: '5.1', 11: '5.2', 12: '5.3', 13: '5.4'}
            hci = int(version.group(1))
            rep.add('bluetooth.version', names.get(hci, f'HCI {hci}'), 'Version Bluetooth',
                    OK if hci >= 9 else WARN if hci >= 6 else BAD, '5.0 ou plus conseille')
    elif active:
        code, out = run(['bluetoothctl', 'show'])
        if code == 0:
            powered = 'Powered: yes' in out
            # BlueZ recent : « Roles: central » si le controleur fait du LE ; sinon on ne sait pas
            le = True if re.search(r'Roles:\s*central', out) else None
    rep.add('bluetooth.le', le, 'Bluetooth basse consommation (BLE)',
            OK if le else BAD if le is False else WARN,
            'necessaire pour la douchette' if le is not False else 'adaptateur sans BLE : douchette impossible')
    if le is None:
        rep.values['bluetooth.le'] = 'inconnu'
        print('      (relancer avec sudo pour lire les capacites exactes avec btmgmt)')
    if powered is not None:
        rep.add('bluetooth.powered', powered, 'Adaptateur allume', OK if powered else WARN,
                '' if powered else 'bluetoothctl power on')
    if scan_seconds and active:
        print(f'      recherche BLE pendant {scan_seconds} s (douchette allumee, pas appairee au systeme)...')
        run(['bluetoothctl', '--timeout', str(scan_seconds), 'scan', 'le'], timeout=scan_seconds + 10)
        code, out = run(['bluetoothctl', 'devices'])
        devices = re.findall(r'Device ([0-9A-F:]{17}) (.*)', out or '')
        rep.add('bluetooth.seen', len(devices), 'Appareils vus', OK if devices else WARN,
                'aucun : antenne faible ou recherche impossible' if not devices else '')
        inateck = [f'{name} ({addr})' for addr, name in devices if re.search(r'inateck|bcst|^p\d', name, re.I)]
        if inateck:
            rep.add('bluetooth.inateck', ', '.join(inateck), 'Douchette probable', OK)
        others = [d for d in devices if run(['bluetoothctl', 'info', d[0]])[1].count('Connected: yes')]
        if others:
            rep.add(None, ', '.join(n for _, n in others), 'Appareils connectes au systeme', WARN,
                    'peuvent faire echouer la recherche du SDK Inateck')


