def compare(paths):
    results = []
    for path in paths:
        data = json.loads(Path(path).read_text())
        results.append((data.get('values', {}).get('machine.name') or Path(path).stem, data.get('values', {})))
    width = max(14, *(len(name) + 2 for name, _ in results))
    print(f'{"":<44}' + ''.join(f'{name:>{width}}' for name, _ in results))
    scores = [score(values) for _, values in results]
    best = max(total for total, _, _, blockers in scores)
    cells = []
    for total, verdict, _, blockers in scores:
        cell = f'{"ELIMINE" if blockers else total:>{width}}'
        if not blockers and total == best and sys.stdout.isatty():
            cell = f'\033[1;32m{cell}\033[0m'
        cells.append(cell)
    print(f'{"SCORE /100":<44}' + ''.join(cells))
    print(f'{"":<44}' + ''.join(f'{", ".join(b) if b else v:>{width}}' for _, v, _, b in scores))
    for key, label, lower in KEY_METRICS:
        values = [values.get(key) for _, values in results]
        if all(value is None for value in values):
            continue
        numbers = [value for value in values if isinstance(value, (int, float)) and not isinstance(value, bool)]
        best = (min(numbers) if lower else max(numbers)) if numbers and lower is not None and len(numbers) > 1 else None
        cells = []
        for value in values:
            text = '—' if value is None else ('oui' if value is True else 'non' if value is False else
                                             f'{value:.1f}' if isinstance(value, float) else str(value))
            cell = f'{text:>{width}}'
            if best is not None and value == best and sys.stdout.isatty():
                cell = f'\033[1;32m{cell}\033[0m'
            cells.append(cell)
        print(f'{label:<44}' + ''.join(cells))


def main():
    parser = argparse.ArgumentParser(description=__doc__, formatter_class=argparse.RawDescriptionHelpFormatter)
    parser.add_argument('--db', help='base a copier pour le test (ex : /var/lib/qrprotec/db.sqlite3) ; '
                        'sinon base fictive de %d lots' % LOTS)
    parser.add_argument('--compare', nargs='+', metavar='JSON', help='compare des resultats deja enregistres')
    args = parser.parse_args()

    if args.compare:
        compare(args.compare)
        return 0
    # sur le disque de la base ; /var/tmp plutot que /tmp, en memoire (tmpfs) sous Fedora
    args.dir = '/var/lib/qrprotec' if os.access('/var/lib/qrprotec', os.W_OK) else '/var/tmp'
    name = platform.node() or 'machine'
    rep = Report()
    rep.values['machine.name'] = name
    print(f'QRProtec : banc de mesure de {name}, {time.strftime("%Y-%m-%d %H:%M")} (environ 5 min, ne rien toucher)')
    machine(rep, args.dir)
    bluetooth(rep)
    kiosk(rep)
    disk(rep, args.dir, FSYNCS)
    sqlite_bench(rep, args.dir)
    cpu(rep)
    app(rep, args)
    endurance(rep, ENDURANCE_MIN)

    warnings = [line for line in rep.lines if line[0] in (BAD, WARN)]
    if warnings:
        print('\nA regarder :')
        for verdict, label, shown, hint in warnings:
            print(f'  {MARKS[verdict]} {label.strip()} : {shown}' + (f' ({hint})' if hint else ''))
    total, verdict, blockers = print_score(rep.values)
    rep.values.update({'score': total, 'verdict': verdict, 'quick': QUICK})
    output = Path(f'qrprotec-bench-{re.sub(r"[^A-Za-z0-9_-]+", "-", name)}-{time.strftime("%Y%m%d-%H%M")}.json')
    try:
        output.write_text(json.dumps({'date': time.strftime('%Y-%m-%dT%H:%M:%S'), 'values': rep.values},
                                     indent=1, ensure_ascii=False, default=str))
        print(f'Resultats : {output.resolve()}  (tools/bench/qrprotec-bench --compare *.json)')
    except OSError as error:
        print(f'Resultats non enregistres : {error}')
    return 1 if blockers else 0


if __name__ == '__main__':
    sys.exit(main())
