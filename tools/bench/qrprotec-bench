class Report:
    def __init__(self):
        self.values = {}
        self.lines = []

    def section(self, title):
        print(f'\n== {title} ==')

    def add(self, key, value, label, verdict=INFO, hint=''):
        if key:
            self.values[key] = value
        shown = f'{value:.2f}' if isinstance(value, float) else ('oui' if value is True else 'non' if value is False
                                                                 else str(value))
        line = f'  {MARKS[verdict]} {label:<44} {shown}'
        if hint:
            line += f'   ({hint})'
        print(line, flush=True)
        self.lines.append((verdict, label, shown, hint))


def grade(value, good, warn, lower_is_better=True):
    if value is None:
        return BAD
    if lower_is_better:
        return OK if value <= good else WARN if value <= warn else BAD
    return OK if value >= good else WARN if value >= warn else BAD


def pct(values, p):
    if not values:
        return None
    ordered = sorted(values)
    return ordered[min(len(ordered) - 1, int(round(p / 100 * (len(ordered) - 1))))]


def run(cmd, timeout=20):
    try:
        result = subprocess.run(cmd, capture_output=True, text=True, timeout=timeout)
        return result.returncode, result.stdout + result.stderr
    except (OSError, subprocess.TimeoutExpired) as error:
        return None, str(error)


def read(path, default=''):
    try:
        return Path(path).read_text().strip()
    except OSError:
        return default


# ---------------------------------------------------------------------------------------------------- machine

def machine(rep, target):
    rep.section('Machine')
    cpu = re.search(r'model name\s*:\s*(.*)', read('/proc/cpuinfo'))
    rep.add('machine.cpu', cpu.group(1) if cpu else platform.processor(), 'Processeur')
    rep.add('machine.cores', os.cpu_count(), 'Coeurs logiques')
    max_freq = read('/sys/devices/system/cpu/cpu0/cpufreq/cpuinfo_max_freq')
    if max_freq:
        rep.add('machine.max_ghz', int(max_freq) / 1e6, 'Frequence max (GHz)')
    mem = re.search(r'MemTotal:\s*(\d+)', read('/proc/meminfo'))
    if mem:
        gib = int(mem.group(1)) / 1024 / 1024
        rep.add('machine.ram_gib', gib, 'Memoire (Gio)', grade(gib, 4, 2, False), '4 Gio suffisent largement')
    os_name = re.search(r'PRETTY_NAME="?([^"\n]*)', read('/etc/os-release'))
    rep.add('machine.os', os_name.group(1) if os_name else platform.platform(), 'Systeme')
    rep.add('machine.kernel', platform.release(), 'Noyau')
    code, out = run(['findmnt', '-no', 'SOURCE,FSTYPE', '--target', str(target)])
    if code == 0 and out.strip():
        source, _, fstype = out.strip().partition(' ')
        in_memory = fstype.strip() in ('tmpfs', 'ramfs')
        rep.add('machine.fs', f'{source} ({fstype.strip()})', f'Partition de {target}', BAD if in_memory else INFO,
                'en memoire : choisir un --dir sur le disque' if in_memory else '')
        code, out = run(['lsblk', '-bsPo', 'NAME,ROTA,TRAN,MODEL,SIZE', source])
        disks = [dict(re.findall(r'(\w+)="([^"]*)"', line)) for line in out.splitlines()] if code == 0 else []
        disks = [d for d in disks if d.get('NAME')]
        if disks:
            disk = disks[-1]  # -s : de la partition vers le disque physique
            rotational = disk.get('ROTA') == '1'
            size = int(disk.get('SIZE') or 0) / 1e9
            rep.add('machine.disk', f"{disk.get('MODEL') or disk['NAME']} ({disk.get('TRAN') or '?'}, {size:.0f} Go)",
                    'Disque')
            rep.values['machine.disk_gb'] = size
            rep.add('machine.rotational', rotational, 'Disque a plateaux (HDD)', BAD if rotational else OK,
                    'un SSD est fortement conseille' + (' ; souvent faux en machine virtuelle' if
                                                        disk.get('TRAN') == 'virtio' or 'vd' in disk['NAME'] else ''))
    storage(rep)
    battery = any(read(p / 'type') == 'Battery' for p in Path('/sys/class/power_supply').glob('*'))
    rep.add('machine.battery', battery, 'Batterie (portable)', OK if battery else INFO,
            'tient une coupure de courant' if battery else 'prevoir un onduleur')


def existing_parent(path):
    path = Path(path)
    while not path.exists():
        path = path.parent
    return path


def backup_dir():
    match = re.search(r'^\s*QRPROTEC_BACKUP_DIR=["\']?([^"\'\n]+)', read('/etc/qrprotec/backup.conf'), re.M)
    return match.group(1).strip() if match else '/var/backups/qrprotec'


def storage(rep):
    """Place libre la ou vivent vraiment la base et les sauvegardes (chemins du RPM), pas dans le dossier de test :
    sous Fedora Server, / est un volume LVM de 15 Go par defaut et le reste du disque n'est pas attribue."""
    places = {}
    for label, path in (('base', '/var/lib/qrprotec'), ('sauvegardes', backup_dir())):
        code, out = run(['findmnt', '-no', 'TARGET,SOURCE', '--target', str(existing_parent(path))])
        mount, _, source = out.strip().partition(' ') if code == 0 and out.strip() else ('/', '', '')
        places.setdefault(mount, (source.strip(), []))[1].append((label, path))
    frees = []
    for mount, (source, labels) in places.items():
        usage = shutil.disk_usage(mount)
        free = usage.free / 1e9
        frees.append(free)
        rep.add(None, f'{free:.1f} / {usage.total / 1e9:.0f} Go', 'Place libre : ' + ' + '.join(l for l, _ in labels),
                grade(free, 20, 5, False), f'{mount} sur {source or "?"} : ' + ', '.join(p for _, p in labels))
    rep.values['machine.free_gb'] = min(frees)
    # LVM : espace du disque pas encore attribue au volume (vgs demande souvent root)
    code, out = run(['vgs', '--noheadings', '--units', 'b', '--nosuffix', '-o', 'vg_name,vg_free'])
    groups = [line.split() for line in out.splitlines() if len(line.split()) == 2] if code == 0 else []
    if groups:
        vg_free = sum(int(float(free)) for _, free in groups) / 1e9
        rep.values['machine.lvm_free_gb'] = vg_free
        rep.add(None, f'{vg_free:.0f} Go', 'Disque non attribue (LVM)', INFO,
                'sudo lvextend -r -l +100%FREE <volume de />' if vg_free > 5 else '')
    elif any(source.startswith('/dev/mapper/') for source, _ in places.values()):
        rep.add(None, 'illisible sans sudo', 'Disque non attribue (LVM)', INFO,
                'sudo vgs : place a ajouter au volume si le disque est plus grand')


