        disk(rep, args.dir, args.fsyncs)
    if 'sqlite' in only:
        sqlite_bench(rep, args.dir)
    if 'cpu' in only:
        cpu(rep)
    if 'app' in only:
        app(rep, args)
    if 'endurance' in only:
        endurance(rep, args.endurance)

    bad = [line for line in rep.lines if line[0] == BAD]
    warn = [line for line in rep.lines if line[0] == WARN]
    print(f'\nBilan : {len(bad)} point(s) bloquant(s), {len(warn)} a surveiller.')
    for verdict, label, shown, hint in bad + warn:
        print(f'  {MARKS[verdict]} {label.strip()} : {shown}' + (f' ({hint})' if hint else ''))
    if args.json:
        Path(args.json).write_text(json.dumps({'date': time.strftime('%Y-%m-%dT%H:%M:%S'), 'values': rep.values},
                                              indent=1, ensure_ascii=False, default=str))
