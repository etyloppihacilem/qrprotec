class Backend:
    def __init__(self, backend, vendor, python, workdir):
        self.backend, self.vendor, self.python, self.workdir = backend, vendor, python, workdir
        self.db = workdir / 'db.sqlite3'
        self.port = free_port()
        self.env = dict(os.environ, QRPROTEC_DB_PATH=str(self.db), QRPROTEC_SECRET_KEY=base64.b64encode(os.urandom(32)).decode(),
                        QRPROTEC_DEBUG='0', DJANGO_SETTINGS_MODULE='qrprotecDB.settings', PYTHONDONTWRITEBYTECODE='1',
                        QRPROTEC_LOCAL_API_TOKEN='', QRPROTEC_ALLOWED_HOSTS='localhost,127.0.0.1')
        if vendor:
            self.env['PYTHONPATH'] = f'{backend}:{vendor}'
        self.process = None

    def manage(self, *args, timeout=600):
        cmd = [self.python, str(self.backend / 'manage.py'), *args]
        return subprocess.run(cmd, cwd=self.workdir, env=self.env, capture_output=True, text=True, timeout=timeout)

    def start(self):
        log = open(self.workdir / 'serve.log', 'w')
        cmd = [self.python, str(self.backend / 'manage.py'), 'serve', '--no-public', '--no-remote',
               '--local', f'127.0.0.1:{self.port}']
        started = time.perf_counter()
        self.process = subprocess.Popen(cmd, cwd=self.workdir, env=self.env, stdout=log, stderr=subprocess.STDOUT)
        while time.perf_counter() - started < 60:
            if self.process.poll() is not None:
                raise RuntimeError(f'serve s\'est arrete, voir {self.workdir / "serve.log"}')
            try:
                with urllib.request.urlopen(f'http://127.0.0.1:{self.port}/api/health/', timeout=1) as response:
                    if response.status == 200:
                        return time.perf_counter() - started
            except (urllib.error.URLError, ConnectionError, socket.timeout):
                time.sleep(0.05)
        raise RuntimeError('serve ne repond pas apres 60 s')

    def rss_mb(self):
        match = re.search(r'VmHWM:\s*(\d+)', read(f'/proc/{self.process.pid}/status'))
        return int(match.group(1)) / 1024 if match else None

    def stop(self):
        if self.process and self.process.poll() is None:
            self.process.terminate()
            try:
                self.process.wait(10)
            except subprocess.TimeoutExpired:
                self.process.kill()


def request(port, method, path, body=None, session=None, timeout=60):
    data = json.dumps(body).encode() if body is not None else None
    req = urllib.request.Request(f'http://127.0.0.1:{port}{path}', data=data, method=method)
    req.add_header('Content-Type', 'application/json')
    if session:
        req.add_header('X-QRProtec-Session', session)
    start = time.perf_counter()
    try:
        with urllib.request.urlopen(req, timeout=timeout) as response:
            payload = response.read()
            status = response.status
    except urllib.error.HTTPError as error:
        payload, status = error.read(), error.code
    except (urllib.error.URLError, ConnectionError, socket.timeout) as error:
        # refus ou coupure de la connexion (file d'attente du serveur pleine), ou delai depasse
        payload, status = f'connexion : {getattr(error, "reason", error)}'.encode(), 0
    return status, (time.perf_counter() - start) * 1000, payload


def load(port, session, lots, clients, seconds):
    """Secouristes simules : etat des lots, fiche d'un lot, verif complete d'un lot (ecriture), parfois la fiche PDF."""
    stop = time.monotonic() + seconds
    lot_ids = list(lots)
    latencies, errors, client_errors, lock = [], [], [0], threading.Lock()
    per_kind = {}

    def client(number):
        rng = random.Random(number)
        while time.monotonic() < stop:
            lot = rng.choice(lot_ids)
            roll = rng.random()
            if roll < 0.25:
                kind, result = 'etat des lots', request(port, 'POST', '/api/lots/summary/', {})
            elif roll < 0.6:
                kind, result = 'fiche', request(port, 'GET', f'/api/lots/{lot}/')
            elif roll < 0.95:
                kind, result = 'verif', request(port, 'POST', f'/api/lots/{lot}/verif/', {'items': lots[lot]}, session)
            else:
                kind, result = 'pdf', request(port, 'GET', f'/api/lots/{lot}/sheet.pdf')
            status, elapsed, payload = result
            with lock:
                latencies.append(elapsed)
                per_kind.setdefault(kind, []).append(elapsed)
                if status == 0 or status >= 500:
                    errors.append(payload[:200].decode(errors='replace'))
                elif status >= 400:
                    client_errors[0] += 1
            time.sleep(rng.uniform(1.0, 3.0))  # entre deux actions : rythme soutenu, plus rapide qu'en vrai

    threads = [threading.Thread(target=client, args=(n,)) for n in range(clients)]
    for thread in threads:
        thread.start()
    for thread in threads:
        thread.join()
    return latencies, errors, client_errors[0], per_kind


class WSClient:
    """Client WebSocket minimal (trames texte masquees), assez pour /ws/live/."""

    def __init__(self, port, path):
        self.sock = socket.create_connection(('127.0.0.1', port), timeout=10)
        key = base64.b64encode(os.urandom(16)).decode()
        self.sock.sendall((f'GET {path} HTTP/1.1\r\nHost: 127.0.0.1\r\nUpgrade: websocket\r\nConnection: Upgrade\r\n'
                           f'Sec-WebSocket-Key: {key}\r\nSec-WebSocket-Version: 13\r\n\r\n').encode())
        head = b''
        while b'\r\n\r\n' not in head:
            chunk = self.sock.recv(1)
            if not chunk:
                raise ConnectionError('WebSocket refuse')
            head += chunk
        if b' 101 ' not in head.split(b'\r\n')[0]:
            raise ConnectionError(head.split(b'\r\n')[0].decode())
        self.lock = threading.Lock()

    def send(self, message):
        payload = json.dumps(message).encode()
        mask = os.urandom(4)
        size = len(payload)
        header = bytes([0x81]) + (bytes([0x80 | size]) if size < 126 else bytes([0x80 | 126]) + struct.pack('!H', size)
                                  if size < 65536 else bytes([0x80 | 127]) + struct.pack('!Q', size))
        with self.lock:
            self.sock.sendall(header + mask + bytes(b ^ mask[i % 4] for i, b in enumerate(payload)))

    def _exact(self, count):
        data = b''
        while len(data) < count:
            chunk = self.sock.recv(count - len(data))
            if not chunk:
                raise ConnectionError('ferme')
            data += chunk
        return data

    def receive(self):
        while True:
            first, second = self._exact(2)
            size = second & 0x7F
            if size == 126:
                size = struct.unpack('!H', self._exact(2))[0]
            elif size == 127:
                size = struct.unpack('!Q', self._exact(8))[0]
            payload = self._exact(size)
            if first & 0x0F == 0x1:
                return json.loads(payload)
            if first & 0x0F == 0x8:
                raise ConnectionError('ferme')

    def close(self):
        try:
            self.sock.close()
        except OSError:
            pass


def ws_bench(port, user, lots, scanners, watchers, seconds):
    """Pages de scan qui publient leur etat, pages de suivi qui le recoivent : delai de diffusion."""
    sent, delays, failures, lock = {}, [], [], threading.Lock()
    stop = time.monotonic() + seconds
    lot_ids = list(lots)
    watch_clients = []
    for _ in range(watchers):
        client = WSClient(port, '/ws/live/watch')
        client.send({'type': 'hello', 'user': user})
        watch_clients.append(client)

    def watch(client):
        client.sock.settimeout(2)
        while time.monotonic() < stop + 1:
            try:
                message = client.receive()
            except (socket.timeout, TimeoutError):
                continue
            except (ConnectionError, OSError, ValueError) as error:
                with lock:
                    failures.append(f'suivi : {error}')
                return
            if message.get('type') == 'error':
                with lock:
                    failures.append(f'suivi : {message.get("message")}')
                return
            session = message.get('session') or {}
            mark = (session.get('id'), session.get('count'))
            with lock:
                if mark in sent:
                    delays.append((time.perf_counter() - sent[mark]) * 1000)

    def scan(number):
        try:
            client = WSClient(port, '/ws/live/scanner')
            client.send({'type': 'hello', 'user': user, 'solo': True})
            hello = client.receive()
            if hello.get('type') != 'hello':
                raise ConnectionError(hello.get('message', 'hello refuse'))
            lot = lot_ids[number % len(lot_ids)]
            seq = 0
            client.sock.settimeout(0.05)
            while time.monotonic() < stop:
                seq += 1
                with lock:
                    sent[(hello['id'], seq)] = time.perf_counter()
                client.send({'type': 'state', 'lot': {'id': lot, 'name': f'Sac {number}'}, 'count': seq,
                             'remaining': 5, 'scanned': [{'name': 'Compresses'}] * min(seq, 40)})
                deadline = time.monotonic() + random.uniform(0.5, 1.5)
                while time.monotonic() < deadline:  # vide les messages "team" recus
                    try:
                        client.receive()
                    except (socket.timeout, TimeoutError):
                        pass
            client.send({'type': 'cancel'})
            client.close()
        except (ConnectionError, OSError, ValueError) as error:
            with lock:
                failures.append(f'scan : {error}')

    threads = [threading.Thread(target=watch, args=(c,)) for c in watch_clients]
    threads += [threading.Thread(target=scan, args=(n,)) for n in range(scanners)]
    for thread in threads:
        thread.start()
    for thread in threads:
        thread.join()
    for client in watch_clients:
        client.close()
    return delays, failures


def app(rep, args):
    rep.section('Back QRProtec (copie de la base, ports libres)')
    backend, vendor, python = find_backend()
    if backend is None:
        rep.add('app.error', python, 'Back : echec', BAD)
        return
    rep.add(None, f'{backend} ({python})', 'Back utilise')
    workdir = Path(tempfile.mkdtemp(prefix='qrprotec-bench-app-', dir=args.dir))
    server = Backend(backend, vendor, python, workdir)
    try:
        if args.db:
            source = sqlite3.connect(f'file:{args.db}?mode=ro', uri=True)
            target = sqlite3.connect(server.db)
            source.backup(target)  # copie coherente meme si le service tourne
            source.close()
            target.close()
            result = server.manage('migrate', '--noinput')
            label = f'copie de {args.db}'
            seed_lots = 0
        else:
            result = server.manage('migrate', '--noinput')
            label = f'base fictive de {LOTS} lots'
            seed_lots = LOTS
        if result.returncode != 0:
            raise RuntimeError(f'migrate : {result.stderr[-800:]}')
        result = server.manage('shell', '-c', SEED.replace("sys.argv[-1]", repr(str(seed_lots))))
        found = re.search(r'BENCH_JSON=(.*)', result.stdout)
        if not found:
            raise RuntimeError(f'preparation de la base : {(result.stderr or result.stdout)[-800:]}')
        data = json.loads(found.group(1))
        lots = data['lots']
        if not lots:
            raise RuntimeError('aucun lot actif avec des items dans la base')
        rep.add(None, f'{label}, {len(lots)} lots, {sum(map(len, lots.values()))} items', 'Donnees')

        startup = server.start()
        rep.add('app.startup_s', startup, 'Demarrage de serve (s)', grade(startup, 3, 10))
        status, _, payload = request(server.port, 'POST', '/api/auth/', data['user'])
        if status != 200:
            raise RuntimeError(f'connexion du secouriste de test : {status} {payload[:200]!r}')
        session = json.loads(payload)['session']

        times = [request(server.port, 'POST', '/api/lots/summary/', {})[1] for _ in range(5)]
        summary = statistics.median(times)
        rep.add('app.lots_summary_ms', summary, f'Etat des lots, {len(lots)} lots (ms)', grade(summary, 300, 1500))
        biggest = max(lots, key=lambda lot: len(lots[lot]))
        pdf = statistics.median(request(server.port, 'GET', f'/api/lots/{biggest}/sheet.pdf')[1] for _ in range(5))
        rep.add('app.sheet_pdf_ms', pdf, 'Fiche PDF du plus gros lot (ms)', grade(pdf, 500, 2000))
        verif = statistics.median(request(server.port, 'POST', f'/api/lots/{biggest}/verif/',
                                          {'items': lots[biggest]}, session)[1] for _ in range(5))
        rep.add('app.verif_ms', verif, f'Verif complete, {len(lots[biggest])} items (ms)', grade(verif, 300, 1500))

        for clients in LEVELS:
            latencies, errors, client_errors, per_kind = load(server.port, session, lots, clients, SECONDS)
            p95 = pct(latencies, 95)
            key = f'app.load_{clients}'
            rep.values[f'{key}.p50_ms'] = pct(latencies, 50)
            rep.values[f'{key}.p99_ms'] = pct(latencies, 99)
            rep.values[f'{key}.errors'] = len(errors)
            rep.values[f'{key}.rps'] = len(latencies) / SECONDS
            detail = ', '.join(f'{kind} {pct(values, 95):.0f}' for kind, values in sorted(per_kind.items()))
            rep.add(f'{key}.p95_ms', p95, f'{clients:2d} secouristes : p95 (ms)',
                    BAD if errors else grade(p95, 300, 2000),
                    f'{len(latencies) / SECONDS:.1f} req/s, {len(errors)} erreurs (5xx ou connexion coupée), {client_errors} 4xx ; '
                    f'p95 : {detail}')
            if errors:
                print(f'      exemple d\'erreur : {errors[0]}')

        delays, failures = ws_bench(server.port, data['user'], lots, WS_SCANNERS, WS_WATCHERS, SECONDS)
        p95 = pct(delays, 95)
        rep.add('app.ws.p95_ms', p95, f'Suivi en direct ({WS_SCANNERS} scans, {WS_WATCHERS} suivis), p95 (ms)',
                BAD if failures or p95 is None else grade(p95, 50, 300),
                f'{len(delays)} messages, {len(failures)} echecs' + (f' : {failures[0]}' if failures else ''))
        rep.add('app.rss_mb', server.rss_mb(), 'Memoire max du back (Mo)', INFO)
        server.stop()

        start = time.perf_counter()
        source = sqlite3.connect(server.db)
        backup = workdir / 'backup.sqlite3'
        target = sqlite3.connect(backup)
        source.backup(target)
        target.close()
        source.close()
        with open(backup, 'rb') as handle:
            os.fsync(handle.fileno())
        rep.add('app.backup_s', time.perf_counter() - start,
                f'Copie de sauvegarde, {backup.stat().st_size / 1e6:.1f} Mo (s)', INFO)
        start = time.perf_counter()
        conn = sqlite3.connect(backup)
        conn.execute('VACUUM')
        conn.close()
        rep.add('app.vacuum_s', time.perf_counter() - start, 'VACUUM de la base (s)', INFO)
    except (RuntimeError, OSError, subprocess.SubprocessError, sqlite3.Error, ValueError, KeyError) as error:
        rep.add('app.error', str(error), 'Back : echec', BAD)
    finally:
        server.stop()
        shutil.rmtree(workdir, ignore_errors=True)


# -------------------------------------------------------------------------------------------------------- score

def scale(value, good, bad, log=True):
    """1 si value atteint good, 0 a bad, entre les deux sur une echelle logarithmique (latences) ou lineaire."""
    if value is None:
        return 0.0
    if log:
        value, good, bad = (math.log(max(x, 1e-6)) for x in (value, good, bad))
    return max(0.0, min(1.0, (bad - value) / (bad - good)))


def score(values):
    """(score sur 100, verdict, [(partie, points, sur, detail)], [raisons d'elimination])."""
    v = values.get
    load = v('app.load_10.p95_ms')
    errors = sum(v(f'app.load_{n}.errors') or 0 for n in LEVELS)
    kiosk_points = 5 * bool(v('kiosk.drm') not in (None, 'aucune')) + 3 * bool(v('kiosk.render')) + 2 * bool(v('kiosk.sound'))
    parts = [
        # partie, poids, note de 0 a 1, detail
        ('Back (10 secouristes)', 25, 0.0 if errors else scale(load, 200, 2000),
         f'p95 {load:.0f} ms' if load is not None else 'non mesure', ),
        ('Disque', 20, scale(v('disk.fdatasync_p99_ms'), 1, 20),
         f'fdatasync p99 {v("disk.fdatasync_p99_ms") or 0:.2f} ms'),
        ('CPU (un coeur)', 20, scale(v('cpu.single_ms'), 150, 1200), f'{v("cpu.single_ms") or 0:.0f} ms'),
        ('SQLite concurrent', 10, 0.0 if v('sqlite.contention_errors') else scale(v('sqlite.contention_p95_ms'), 10, 300),
         f'p95 {v("sqlite.contention_p95_ms") or 0:.1f} ms'),
        ('Chauffe', 10, scale(v('endurance.slowdown_pct'), 5, 35, log=False),
         f'{v("endurance.slowdown_pct") or 0:+.0f} % de lenteur'),
        ('Kiosk (GPU, son)', 10, kiosk_points / 10, f'{kiosk_points}/10'),
        ('Suivi en direct', 5, scale(v('app.ws.p95_ms'), 20, 300), f'p95 {v("app.ws.p95_ms") or 0:.0f} ms'),
    ]
    if errors:
        parts[0] = (*parts[0][:3], f'{errors} erreur(s) sous charge')
    rows = [(name, weight * note, weight, detail) for name, weight, note, detail in parts]
    total = round(sum(points for _, points, _, _ in rows))
    blockers = []
    if not v('bluetooth.adapter'):
        blockers.append('pas de Bluetooth')
    elif v('bluetooth.hard_blocked'):
        blockers.append('Bluetooth coupe materiellement')
    elif v('bluetooth.le') is False:
        blockers.append('Bluetooth sans BLE')
    if v('machine.rotational'):
        blockers.append('disque a plateaux')
    if v('machine.free_gb') is not None and v('machine.free_gb') < 2 and (v('machine.lvm_free_gb') or 0) < 2:
        blockers.append('moins de 2 Go libres pour la base et les sauvegardes')
    if (v('machine.ram_gib') or 0) and v('machine.ram_gib') < 1.8:
        blockers.append('moins de 2 Gio de memoire')
    if v('app.error'):
        blockers.append('le back n\'a pas tourne')
    if blockers:
        verdict = 'ELIMINE'
    else:
        verdict = 'Excellent' if total >= 80 else 'Convenable' if total >= 60 else 'Limite' if total >= 40 else 'Insuffisant'
    return total, verdict, rows, blockers


def print_score(values):
    total, verdict, rows, blockers = score(values)
    color = '' if not sys.stdout.isatty() else ('\033[31m' if blockers or total < 40 else '\033[33m' if total < 60
                                                else '\033[32m')
    reset = '\033[0m' if color else ''
    print('\n' + '=' * 64)
    print(f'  {color}SCORE {total}/100 : {verdict}{reset}' + (f'  ({", ".join(blockers)})' if blockers else ''))
    print('=' * 64)
    for name, points, weight, detail in rows:
        bar = '█' * round(points / weight * 10) + '·' * (10 - round(points / weight * 10))
        print(f'  {name:<22} {bar} {points:4.1f}/{weight:<3} {detail}')
    print('  80+ excellent, 60-79 convenable, 40-59 limite, <40 insuffisant ; ELIMINE = point bloquant')
    return total, verdict, blockers


