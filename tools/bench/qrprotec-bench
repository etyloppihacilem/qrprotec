def bluetooth(rep):
    """Presence du Bluetooth seulement (la douchette Inateck est en BLE) : aucun appareil a allumer ni a approcher."""
    rep.section('Bluetooth (douchette)')
    adapters = sorted(p for p in Path('/sys/class/bluetooth').glob('hci*') if ':' not in p.name)
    rep.add('bluetooth.adapter', bool(adapters), 'Adaptateur Bluetooth present', OK if adapters else BAD,
            ', '.join(p.name for p in adapters) if adapters else 'aucun : douchette impossible (dongle USB BT 5 ?)')
    if not adapters:
        return
    device = adapters[0] / 'device'
    driver = os.path.basename(os.path.realpath(device / 'driver')) if (device / 'driver').exists() else '?'
    usb = re.search(r'usb:v([0-9A-F]{4})p([0-9A-F]{4})', read(device / 'modalias'))
    rep.add(None, driver + (f', USB {usb.group(1).lower()}:{usb.group(2).lower()}' if usb else ''), '  Pilote')
    hard = [read(r / 'name') for r in Path('/sys/class/rfkill').glob('rfkill*')
            if read(r / 'type') == 'bluetooth' and read(r / 'hard') == '1']
    rep.add('bluetooth.hard_blocked', bool(hard), 'Coupe par un interrupteur ou le BIOS', BAD if hard else OK)
    # version / BLE : lisibles sans root avec la plupart des BlueZ ; sinon on ne penalise pas
    code, out = run(['btmgmt', '--index', adapters[0].name[3:], 'info'])
    supported = re.search(r'supported settings:(.*)', out or '') if code == 0 else None
    if supported:
        le = ' le' in f' {supported.group(1)} '
        rep.add('bluetooth.le', le, 'Basse consommation (BLE)', OK if le else BAD,
                '' if le else 'necessaire pour la douchette')
        version = re.search(r'version (\d+)', out)
        if version:
            names = {6: '4.0', 7: '4.1', 8: '4.2', 9: '5.0', 10: '5.1', 11: '5.2', 12: '5.3', 13: '5.4'}
            rep.add('bluetooth.version', names.get(int(version.group(1)), version.group(1)), 'Version', INFO)
    code, out = run(['systemctl', 'is-active', 'bluetooth'])
    active = out.strip() == 'active'
    rep.add('bluetooth.service', active, 'Service bluetooth actif', OK if active else INFO,
            '' if active else 'active par le RPM qrprotec-kiosk')


