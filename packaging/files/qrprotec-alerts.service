[Unit]
Description=QRProtec : notifications SMS quotidiennes (stock bas, lots perimes)
Documentation=file:///usr/share/doc/qrprotec/README.md
After=qrprotec.service

[Service]
Type=oneshot
User=qrprotec
Group=qrprotec
EnvironmentFile=/etc/qrprotec/qrprotec.conf
StateDirectory=qrprotec
WorkingDirectory=/var/lib/qrprotec
UMask=0027
ExecStart=/usr/bin/qrprotec-manage check_alerts

NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
PrivateDevices=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
ProtectClock=yes
ProtectHostname=yes
ProtectProc=invisible
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
RestrictNamespaces=yes
RestrictRealtime=yes
RestrictSUIDSGID=yes
LockPersonality=yes
CapabilityBoundingSet=
SystemCallArchitectures=native
SystemCallFilter=@system-service
SystemCallFilter=~@privileged
