#!/usr/bin/bash
# Session du kiosk, lancee par Cage (qrprotec-kiosk.service) : programme l'extinction de l'ecran
# puis lance le front QRProtec (qrprotec-front, qui prepare le dossier des modeles).
#
#   qrprotec-kiosk-session                # session (front)
#   qrprotec-kiosk-session --screen off   # eteint / rallume les ecrans (appele par swayidle)
set -u

readonly FRONT=@BINDIR@/qrprotec-front

# Allume (on) ou eteint (off) tous les ecrans. Couper la sortie (DPMS) ne fait qu'arreter le signal
# video : beaucoup d'ecrans restent alors noirs mais retroeclaires (dalle interne d'un portable ou
# d'un tout-en-un, moniteurs qui ne se mettent pas en veille sans signal). On coupe donc aussi :
#   - le retroeclairage (/sys/class/backlight) via logind, sans droit particulier ;
#   - les moniteurs externes par DDC/CI (ddcutil), sauf QRPROTEC_SCREEN_DDC=0.
readonly STATE_DIR=${XDG_RUNTIME_DIR:-/tmp}/qrprotec-screen

# Journal du kiosk (journalctl -u qrprotec-kiosk), y compris depuis les commandes de swayidle
log() {
    echo "qrprotec-kiosk : $*" >&2
}

# Sorties Wayland : DPMS (wlopm, wlr-output-power-management) si Cage le gere, sinon desactivation
# des sorties (wlr-randr, wlr-output-management ; Cage n'implemente que celui-ci).
outputs() {
    local state=$1 output
    if command -v wlopm >/dev/null && wlopm "--$state" '*' 2>/dev/null; then
        log "ecrans $state (wlopm)"
        return 0
    fi
    if command -v wlr-randr >/dev/null; then
        while read -r output; do
            if wlr-randr --output "$output" "--$state"; then
                log "sortie $output $state (wlr-randr)"
            else
                log "sortie $output : wlr-randr --$state a echoue"
            fi
        done < <(wlr-randr | awk '/^[^[:space:]]/ {print $1}')
    else
        log "ni wlopm ni wlr-randr : sorties video laissees allumees"
    fi
}

# Retroeclairage : SetBrightness de logind (session du kiosk). Allume, il est remis a
# QRPROTEC_SCREEN_BRIGHTNESS % du maximum (100 par defaut) : sans bureau, les touches de luminosite
# ne font rien, et systemd-backlight restaure au demarrage la valeur enregistree a l'arret (0, ramene
# a son minimum, si la borne s'est arretee ecran eteint).
backlight() {
    local state=$1 dev name level percent=${QRPROTEC_SCREEN_BRIGHTNESS:-100}
    [[ $percent =~ ^[0-9]+$ ]] && ((percent >= 1 && percent <= 100)) || percent=100
    for dev in /sys/class/backlight/*; do
        [[ -r $dev/max_brightness ]] || continue
        name=${dev##*/}
        level=0
        if [[ $state == on ]]; then
            level=$(($(<"$dev/max_brightness") * percent / 100))
            ((level > 0)) || level=1
        fi
        if busctl call org.freedesktop.login1 /org/freedesktop/login1/session/auto \
            org.freedesktop.login1.Session SetBrightness ssu backlight "$name" "$level"; then
            log "retroeclairage $name a $level"
        else
            log "retroeclairage $name non modifiable"
        fi
    done
}

# Moniteurs externes : mode d'alimentation DDC/CI (VCP D6 : 01 allume, 04 veille).
ddc() {
    local state=$1 display
    [[ ${QRPROTEC_SCREEN_DDC:-1} == 0 ]] && return 0
    command -v ddcutil >/dev/null || return 0
    if [[ $state == off ]]; then
        ddcutil detect --terse 2>/dev/null | awk '/^Display [0-9]+/ {print $2}' >"$STATE_DIR/ddc"
    fi
    [[ -r $STATE_DIR/ddc ]] || return 0
    while read -r display; do
        if ddcutil --display "$display" --noverify setvcp D6 "$([[ $state == off ]] && echo 04 || echo 01)"; then
            log "ecran DDC/CI $display $state"
        else
            log "ecran DDC/CI $display non modifiable"
        fi
    done <"$STATE_DIR/ddc"
}

screen() {
    mkdir -p "$STATE_DIR"
    log "$([[ $1 == off ]] && echo "inactivite : extinction" || echo "activite : rallumage") de l'ecran"
    if [[ $1 == off ]]; then
        backlight off
        ddc off
        outputs off
    else
        # Signal video d'abord : beaucoup de moniteurs se reveillent deja en le retrouvant
        outputs on
        ddc on
        backlight on
    fi
}

if [[ ${1:-} == --screen ]]; then
    screen "${2:?on ou off}"
    exit
fi

# Modeles du kiosk dans son dossier personnel (initialises par qrprotec-front avec ceux fournis)
templates=${QRPROTEC_TEMPLATES_DIR:-${HOME:-/var/lib/qrprotec-kiosk}/templates}
export QRPROTEC_TEMPLATES_DIR=$templates
# Borne : la connexion au serveur ne se modifie pas sans badge administrateur (voir qrprotec-setup)
export QRPROTEC_KIOSK=1

# Luminosite de l'ecran au demarrage du kiosk
backlight on

blank=${QRPROTEC_SCREEN_BLANK_SECONDS:-1800}
if [[ $blank =~ ^[0-9]+$ ]] && ((blank > 0)); then
    if command -v swayidle >/dev/null && { command -v wlopm || command -v wlr-randr; } >/dev/null; then
        swayidle -w timeout "$blank" "$0 --screen off" resume "$0 --screen on" &
        log "extinction de l'ecran apres $blank s sans activite (swayidle, pid $!)"
    else
        log "swayidle ou wlopm/wlr-randr absent, pas d'extinction de l'ecran"
    fi
else
    log "extinction de l'ecran desactivee (QRPROTEC_SCREEN_BLANK_SECONDS=$blank)"
fi

# Diagnostic (journalctl -u qrprotec-kiosk) : bibliotheques que GLFW charge avec dlopen
for lib in libwayland-client.so.0 libwayland-cursor.so.0 libwayland-egl.so.1 libxkbcommon.so.0 libEGL.so.1; do
    if ! /usr/sbin/ldconfig -p 2>/dev/null | grep -q "$lib"; then
        echo "qrprotec-kiosk : $lib introuvable, le front ne pourra pas ouvrir sa fenetre" >&2
    fi
done
echo "qrprotec-kiosk : WAYLAND_DISPLAY=${WAYLAND_DISPLAY:-?} XDG_RUNTIME_DIR=${XDG_RUNTIME_DIR:-?} modeles=$templates" \
    "serveur=${QRPROTEC_API_URL:-API locale}" >&2
# QRPROTEC_FRONT_ARGS (kiosk.conf) : options du front, ex. --verbose
read -r -a front_args <<<"${QRPROTEC_FRONT_ARGS:-}"
"$FRONT" "${front_args[@]}" "$@"
status=$?
echo "qrprotec-kiosk : le front s'est arrete (code $status), Cage va redemarrer" >&2
exit "$status"
