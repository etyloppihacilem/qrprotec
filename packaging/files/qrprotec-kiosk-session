#!/usr/bin/bash
# Session du kiosk, lancee par Cage (qrprotec-kiosk.service) : programme l'extinction de l'ecran
# puis lance le front QRProtec (qrprotec-front, qui prepare le dossier des modeles).
#
#   qrprotec-kiosk-session                # session (front)
#   qrprotec-kiosk-session --screen off   # eteint / rallume les ecrans (appele par swayidle)
set -u

readonly FRONT=@BINDIR@/qrprotec-front

# Allume (on) ou eteint (off) tous les ecrans : DPMS (wlopm) si Cage le gere, sinon desactivation
# des sorties (wlr-randr, wlr-output-management).
screen() {
    local state=$1 output
    if command -v wlopm >/dev/null && wlopm "--$state" '*' 2>/dev/null; then
        return 0
    fi
    if command -v wlr-randr >/dev/null; then
        while read -r output; do
            wlr-randr --output "$output" "--$state"
        done < <(wlr-randr | awk '/^[^[:space:]]/ {print $1}')
    fi
}

if [[ ${1:-} == --screen ]]; then
    screen "${2:?on ou off}"
    exit
fi

# Modeles du kiosk dans son dossier personnel (initialises par qrprotec-front avec ceux fournis)
templates=${QRPROTEC_TEMPLATES_DIR:-${HOME:-/var/lib/qrprotec-kiosk}/templates}
export QRPROTEC_TEMPLATES_DIR=$templates
# Borne : la connexion au serveur ne se modifie pas sans badge administrateur (voir qrprotec-setup)
export QRPROTEC_KIOSK=1

blank=${QRPROTEC_SCREEN_BLANK_SECONDS:-1800}
if [[ $blank =~ ^[0-9]+$ ]] && ((blank > 0)); then
    if command -v swayidle >/dev/null && { command -v wlopm || command -v wlr-randr; } >/dev/null; then
        swayidle -w timeout "$blank" "$0 --screen off" resume "$0 --screen on" &
    else
        echo "qrprotec-kiosk : swayidle ou wlopm/wlr-randr absent, pas d'extinction de l'ecran" >&2
    fi
fi

# Diagnostic (journalctl -u qrprotec-kiosk) : bibliotheques que GLFW charge avec dlopen
for lib in libwayland-client.so.0 libwayland-cursor.so.0 libwayland-egl.so.1 libxkbcommon.so.0 libEGL.so.1; do
    if ! /usr/sbin/ldconfig -p 2>/dev/null | grep -q "$lib"; then
        echo "qrprotec-kiosk : $lib introuvable, le front ne pourra pas ouvrir sa fenetre" >&2
    fi
done
echo "qrprotec-kiosk : WAYLAND_DISPLAY=${WAYLAND_DISPLAY:-?} XDG_RUNTIME_DIR=${XDG_RUNTIME_DIR:-?} modeles=$templates" \
    "serveur=${QRPROTEC_API_URL:-API locale}" >&2
# QRPROTEC_FRONT_ARGS (kiosk.conf) : options du front, ex. --verbose
read -r -a front_args <<<"${QRPROTEC_FRONT_ARGS:-}"
"$FRONT" "${front_args[@]}" "$@"
status=$?
echo "qrprotec-kiosk : le front s'est arrete (code $status), Cage va redemarrer" >&2
exit "$status"
