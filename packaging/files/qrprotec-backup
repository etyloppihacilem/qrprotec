#!/usr/bin/bash
# Sauvegarde et restauration de QRProtec (back, kiosk, ou les deux sur la meme machine).
#
#   sudo qrprotec-backup                       # cree une archive (et supprime les plus anciennes)
#   sudo qrprotec-backup --list                # liste les archives
#   sudo qrprotec-backup --restore ARCHIVE     # restaure base + configuration (voir aussi qrprotec-setup)
#   sudo qrprotec-backup --apply-schedule      # applique QRPROTEC_BACKUP_SCHEDULE au timer systemd
#   sudo qrprotec-backup --sync                # envoie seulement les archives sur la machine distante
#
# Machine distante (QRPROTEC_BACKUP_SYNC_TARGET) : apres chaque sauvegarde, le dossier des archives est recopie par
# rsync sur SSH (cle /etc/qrprotec/backup_ssh_key, creee par qrprotec-setup --backup-sync). Une sauvegarde ou un envoi
# en echec previent les admins (notification « Problème de serveur », a activer dans le front web) : le detail est
# dans `journalctl -u qrprotec-backup`.
#
# Archive : <QRPROTEC_BACKUP_DIR>/qrprotec-backup_AAAA-MM-JJ_HHMMSS.tar.xz (0600 root), contenant ce
# qui est installe sur cette machine :
#   - back (qrprotec-server) : instantane coherent de la base SQLite (API de sauvegarde de SQLite,
#     service en marche), /etc/qrprotec (cle secrete comprise), le fragment Caddy ;
#   - kiosk (qrprotec-kiosk) : /etc/qrprotec (connexion au back distant comprise), reglages et
#     modeles d'etiquettes du kiosk.
# Reglages : /etc/qrprotec/backup.conf (ou sudo qrprotec-setup).
set -euo pipefail
umask 077

readonly CONF_DIR=/etc/qrprotec
readonly BACKUP_CONF=$CONF_DIR/backup.conf
readonly CADDY_FRAGMENT=/etc/caddy/Caddyfile.d/qrprotec.caddyfile
readonly KIOSK_HOME=/var/lib/qrprotec-kiosk
readonly TIMER_DROPIN_DIR=/etc/systemd/system/qrprotec-backup.timer.d
readonly PREFIX=qrprotec-backup_
readonly SYNC_KEY=$CONF_DIR/backup_ssh_key
readonly SYNC_KNOWN_HOSTS=$CONF_DIR/backup_known_hosts
# 1 : base toujours presente (paquet unique) ; 2 : parties listees dans MANIFEST (parts=server,kiosk)
readonly FORMAT=2

# ERROR_FILE : message gardé pour la notification « Problème de serveur »
die() {
    echo "qrprotec-backup : $*" >&2
    if [[ -n ${ERROR_FILE:-} ]]; then printf '%s\n' "$*" >"$ERROR_FILE"; fi
    exit 1
}
log() { echo "qrprotec-backup : $*"; }

usage() {
    cat <<USAGE
Usage : qrprotec-backup [--no-rotate] [--no-report] [--dir DOSSIER]
        qrprotec-backup --list
        qrprotec-backup --restore ARCHIVE [--db-only] [--yes]

Le contenu depend des paquets installes : base et configuration du back (qrprotec-server),
configuration, reglages et modeles du kiosk (qrprotec-kiosk).
        qrprotec-backup --apply-schedule
        qrprotec-backup --sync [--no-report]

Une sauvegarde ou un envoi en echec previent les admins (notification « Problème de serveur »),
sauf avec --no-report.

Reglages (/etc/qrprotec/backup.conf) :
  QRPROTEC_BACKUP_DIR       dossier des archives        (defaut /var/backups/qrprotec)
  QRPROTEC_BACKUP_KEEP      archives recentes gardees   (defaut 14, 0 = toutes, sans rotation)
  QRPROTEC_BACKUP_KEEP_WEEKLY   plus une par semaine sur N semaines   (defaut 8)
  QRPROTEC_BACKUP_KEEP_MONTHLY  plus une par mois sur N mois          (defaut 12)
  QRPROTEC_BACKUP_MIN_FREE  % de place libre gardee dans le dossier : les plus anciennes sont
                            supprimees en dessous (defaut 10, jamais les 3 plus recentes)
  QRPROTEC_BACKUP_SCHEDULE  frequence : hourly, daily, weekly, monthly, une expression
                            OnCalendar de systemd (ex. "*-*-* 03:30"), ou off
  QRPROTEC_BACKUP_SYNC_TARGET  copie des archives sur une autre machine, par rsync sur SSH :
                            utilisateur@machine:/dossier (vide = pas d'envoi ; sudo qrprotec-setup --backup-sync)
  QRPROTEC_BACKUP_SYNC_PORT    port SSH                     (defaut 22)
  QRPROTEC_BACKUP_SYNC_DELETE  yes : miroir, les archives supprimees ici le sont aussi la-bas ; no : tout garder
                            la-bas (defaut yes)
USAGE
}

# Fichier KEY=valeur : seules les cles QRPROTEC_* sont lues (jamais execute)
read_conf() {
    local file=$1 key value
    [[ -r $file ]] || return 0
    while IFS='=' read -r key value; do
        [[ $key =~ ^QRPROTEC_[A-Z0-9_]+$ ]] || continue
        value=${value%\"}
        value=${value#\"}
        printf -v "$key" '%s' "$value"
    done <"$file"
}

load_settings() {
    read_conf "$CONF_DIR/qrprotec.conf"
    read_conf "$CONF_DIR/kiosk.conf"
    read_conf "$CONF_DIR/front-api.conf"
    read_conf "$BACKUP_CONF"
    backup_dir=${QRPROTEC_BACKUP_DIR:-/var/backups/qrprotec}
    keep=${QRPROTEC_BACKUP_KEEP:-14}
    keep_weekly=${QRPROTEC_BACKUP_KEEP_WEEKLY:-8}
    keep_monthly=${QRPROTEC_BACKUP_KEEP_MONTHLY:-12}
    min_free=${QRPROTEC_BACKUP_MIN_FREE:-10}
    schedule=${QRPROTEC_BACKUP_SCHEDULE:-daily}
    sync_target=${QRPROTEC_BACKUP_SYNC_TARGET:-}
    sync_port=${QRPROTEC_BACKUP_SYNC_PORT:-22}
    sync_delete=${QRPROTEC_BACKUP_SYNC_DELETE:-yes}
    db_path=${QRPROTEC_DB_PATH:-/var/lib/qrprotec/db.sqlite3}
    # parties installees sur cette machine
    has_server=no has_kiosk=no
    [[ -f $CONF_DIR/qrprotec.conf ]] && id qrprotec >/dev/null 2>&1 && has_server=yes
    [[ -f $CONF_DIR/kiosk.conf ]] && id qrprotec-kiosk >/dev/null 2>&1 && has_kiosk=yes
    templates_dir=$(kiosk_templates_dir)
    [[ $keep =~ ^[0-9]+$ ]] || die "QRPROTEC_BACKUP_KEEP invalide : $keep"
    [[ $keep_weekly =~ ^[0-9]+$ ]] || die "QRPROTEC_BACKUP_KEEP_WEEKLY invalide : $keep_weekly"
    [[ $keep_monthly =~ ^[0-9]+$ ]] || die "QRPROTEC_BACKUP_KEEP_MONTHLY invalide : $keep_monthly"
    if [[ ! $min_free =~ ^[0-9]+$ ]] || ((min_free >= 90)); then die "QRPROTEC_BACKUP_MIN_FREE invalide : $min_free"; fi
    [[ $backup_dir == /* ]] || die "QRPROTEC_BACKUP_DIR doit etre un chemin absolu : $backup_dir"
}

# Destination rsync sur SSH : [utilisateur@]machine:dossier (pas de demon rsync « :: », pas de chemin local)
valid_sync_target() {
    [[ $1 =~ ^[^[:space:]:/]+:[^[:space:]]+$ || $1 =~ ^[^[:space:]@/]+@\[[0-9A-Fa-f:.]+\]:[^[:space:]]+$ ]] &&
        [[ $1 != *::* || $1 == *\[*\]* ]]
}

# Copie le dossier des archives sur la machine distante (rsync sur SSH, cle dediee). Seules les archives
# qrprotec-backup_*.tar.xz sont envoyees (et supprimees la-bas en miroir) : rien d'autre n'est touche la-bas.
sync_backups() {
    local count host_check=yes errors
    valid_sync_target "$sync_target" || die "QRPROTEC_BACKUP_SYNC_TARGET invalide (utilisateur@machine:/dossier) : $sync_target"
    [[ $sync_port =~ ^[0-9]+$ ]] || die "QRPROTEC_BACKUP_SYNC_PORT invalide : $sync_port"
    command -v rsync >/dev/null || die "rsync n'est pas installe (sudo dnf install rsync)"
    command -v ssh >/dev/null || die "ssh n'est pas installe (sudo dnf install openssh-clients)"
    [[ -r $SYNC_KEY ]] || die "cle SSH introuvable ($SYNC_KEY) : sudo qrprotec-setup --backup-sync $sync_target"
    count=$(archives | wc -l)
    # dossier vide (disque change, demonte...) : en miroir, l'envoi effacerait les copies distantes
    ((count > 0)) || die "aucune archive dans $backup_dir : envoi annule, la copie sur $sync_target est gardee"
    # Lance a la main (terminal, qrprotec-setup) : la cle de la machine distante est enregistree a la premiere
    # connexion. Sous systemd, seule une machine deja connue est acceptee (/etc en lecture seule pour le service).
    [[ -z ${INVOCATION_ID:-} ]] && host_check=accept-new
    local ssh_command="ssh -i $SYNC_KEY -p $sync_port -o BatchMode=yes -o IdentitiesOnly=yes"
    ssh_command+=" -o StrictHostKeyChecking=$host_check -o UserKnownHostsFile=$SYNC_KNOWN_HOSTS"
    ssh_command+=" -o ConnectTimeout=20 -o ServerAliveInterval=15 -o LogLevel=ERROR -o ServerAliveCountMax=4"
    local args=(-rt --mkpath --chmod='D0700,F0600' --timeout=300 --include="${PREFIX}*.tar.xz" --exclude='*'
                -e "$ssh_command")
    [[ $sync_delete == yes ]] && args+=(--delete)
    local status=0 detail
    errors=$(mktemp)
    rsync "${args[@]}" "$backup_dir/" "$sync_target" 2> >(tee "$errors" >&2) || status=$?
    if ((status != 0)); then
        sleep 0.2  # fin de tee
        # premiere ligne utile (ex. « Permission denied (publickey) »), pas les lignes generiques de rsync
        detail=$(grep -Ev '^[[:space:]]*$|^Warning:|^rsync: connection unexpectedly closed|^rsync error:' "$errors" |
                 head -n 1)
        rm -f "$errors"
        die "envoi vers $sync_target impossible (rsync, code $status)${detail:+ : $detail}"
    fi
    rm -f "$errors"
    log "archives envoyees sur $sync_target ($count)"
}

# Notification « Problème de serveur » des admins : par le back de cette machine, sinon par l'API du back distant
# (kiosk relie a un serveur, cle du front). Ne fait jamais echouer la sauvegarde.
#   report SOURCE MESSAGE   (backup ou sync) ; report SOURCE (sans message) : la source refonctionne
report() {
    local source=$1 message=${2-} resolved=no
    [[ $no_report == yes ]] && return 0
    [[ $# -eq 1 ]] && resolved=yes
    if [[ $has_server == yes ]] && command -v qrprotec-manage >/dev/null; then
        if [[ $resolved == yes ]]; then
            qrprotec-manage server_problem "$source" --resolved >/dev/null 2>&1 || :
        else
            qrprotec-manage server_problem "$source" "$message" ||
                echo "qrprotec-backup : notification des admins impossible" >&2
        fi
    elif [[ -n ${QRPROTEC_API_URL:-} && -n ${QRPROTEC_API_KEY:-} ]] && command -v curl >/dev/null; then
        local body curl_args=(-fsS --max-time 20 -H @- -H 'Content-Type: application/json' -o /dev/null)
        [[ -n ${QRPROTEC_API_CA_FILE:-} ]] && curl_args+=(--cacert "$QRPROTEC_API_CA_FILE")
        body=$(python3 -c 'import json, sys; print(json.dumps({"source": sys.argv[1], "message": sys.argv[2],
               "resolved": sys.argv[3] == "yes"}))' "$source" "$message" "$resolved")
        # cle par l'entree standard (-H @-), pas dans la ligne de commande (visible dans `ps`)
        if ! printf 'X-QRProtec-Key: %s\n' "$QRPROTEC_API_KEY" |
                curl "${curl_args[@]}" --data "$body" "${QRPROTEC_API_URL%/}/api/server-problem/"; then
            [[ $resolved == yes ]] || echo "qrprotec-backup : notification des admins impossible (serveur injoignable)" >&2
        fi
    fi
}

# Lance une etape (create_backup, sync_backups) dans un sous-shell ; en cas d'echec, previent les admins.
run_step() {
    local source=$1 status=0 message
    shift
    ERROR_FILE=$(mktemp)
    ("$@") || status=$?
    message=$(head -n 1 "$ERROR_FILE")
    rm -f "$ERROR_FILE"
    ERROR_FILE=""
    if ((status != 0)); then
        report "$source" "${message:-erreur inattendue (code $status)}"
    else
        report "$source"
    fi
    return "$status"
}

# Dossier des modeles d'etiquettes du kiosk : celui choisi dans les reglages de l'app (templates_dir= de app.conf)
# l'emporte, sinon QRPROTEC_TEMPLATES_DIR (kiosk.conf), sinon celui par defaut de qrprotec-kiosk-session
kiosk_templates_dir() {
    local chosen=""
    if [[ -r $KIOSK_HOME/.config/qrprotec/app.conf ]]; then
        chosen=$(sed -n 's/^templates_dir=//p' "$KIOSK_HOME/.config/qrprotec/app.conf" | tail -n 1)
    fi
    if [[ $chosen == /* ]]; then
        echo "$chosen"
    else
        echo "${QRPROTEC_TEMPLATES_DIR:-$KIOSK_HOME/templates}"
    fi
}

# Copie coherente d'une base SQLite, meme ouverte par le back
sqlite_snapshot() {
    python3 - "$1" "$2" <<'PY'
import sqlite3, sys
source = sqlite3.connect(f"file:{sys.argv[1]}?mode=ro", uri=True)
target = sqlite3.connect(sys.argv[2])
with target:
    source.backup(target)
result = target.execute("PRAGMA integrity_check").fetchone()[0]
target.close()
source.close()
if result != "ok":
    sys.exit(f"base corrompue : {result}")
PY
}

sqlite_check() {
    python3 - "$1" <<'PY'
import sqlite3, sys
connection = sqlite3.connect(f"file:{sys.argv[1]}?mode=ro", uri=True)
result = connection.execute("PRAGMA integrity_check").fetchone()[0]
tables = connection.execute("SELECT count(*) FROM sqlite_master WHERE name = 'django_migrations'").fetchone()[0]
connection.close()
if result != "ok" or not tables:
    sys.exit(f"base invalide ({result})")
PY
}

archives() {
    find "$backup_dir" -maxdepth 1 -type f -name "${PREFIX}*.tar.xz" -printf '%f\n' 2>/dev/null | sort
}

create_backup() {
    local rotate=$1 stamp name work archive parts=()
    [[ $has_server == yes || $has_kiosk == yes ]] || die "ni back (qrprotec-server) ni kiosk installe"
    if [[ $has_server == yes ]]; then
        [[ -f $db_path ]] || die "base introuvable : $db_path"
        parts+=(server)
    fi
    if [[ $has_kiosk == yes ]]; then
        parts+=(kiosk)
    fi
    if [[ ! -d $backup_dir ]]; then
        mkdir -p "$backup_dir"
        chmod 0700 "$backup_dir"
    fi

    # Deux archives dans la meme seconde (restauration juste apres une sauvegarde) : attendre la suivante
    local tries=0
    while :; do
        stamp=$(date +%Y-%m-%d_%H%M%S)
        name=${PREFIX}${stamp}
        archive=$backup_dir/$name.tar.xz
        [[ -e $archive ]] || break
        ((++tries < 3)) || die "$archive existe deja"
        sleep 1
    done
    work=$(mktemp -d)
    # shellcheck disable=SC2064
    trap "rm -rf '$work'" EXIT
    mkdir -p "$work/$name"

    if [[ $has_server == yes ]]; then
        sqlite_snapshot "$db_path" "$work/$name/db.sqlite3"
    fi

    mkdir -p "$work/$name/etc/qrprotec" "$work/$name/etc/caddy/Caddyfile.d"
    find "$CONF_DIR" -maxdepth 1 -type f ! -name '*.rpm*' -exec cp -p {} "$work/$name/etc/qrprotec/" \;
    if [[ $has_server == yes && -f $CADDY_FRAGMENT ]]; then
        cp -p "$CADDY_FRAGMENT" "$work/$name/etc/caddy/Caddyfile.d/"
    fi
    if [[ $has_kiosk == yes && -d $KIOSK_HOME/.config/qrprotec ]]; then
        mkdir -p "$work/$name/kiosk"
        cp -a "$KIOSK_HOME/.config/qrprotec" "$work/$name/kiosk/config"
    fi
    if [[ $has_kiosk == yes && -d $templates_dir ]]; then
        mkdir -p "$work/$name/kiosk"
        cp -a "$templates_dir" "$work/$name/kiosk/templates"
    fi

    cat >"$work/$name/MANIFEST" <<MANIFEST
format=$FORMAT
date=$(date --iso-8601=seconds)
host=$(uname -n)
parts=$(IFS=,; echo "${parts[*]}")
packages=$(rpm -qa 'qrprotec*' 2>/dev/null | sort | paste -sd, -)
domain=${QRPROTEC_DOMAIN:-}
api_url=${QRPROTEC_API_URL:-}
MANIFEST

    XZ_OPT=${XZ_OPT:--6 -T0} tar -C "$work" --numeric-owner -cJf "$archive.part" "$name"
    chmod 0600 "$archive.part"
    mv "$archive.part" "$archive"
    log "archive creee : $archive ($(du -h "$archive" | cut -f1))"

    if [[ $rotate == yes ]]; then prune_archives; fi
}

# Rotation a paliers : les KEEP plus recentes, puis la plus recente de chacune des KEEP_WEEKLY dernieres semaines
# et de chacun des KEEP_MONTHLY derniers mois (ex. 14 + 8 + 12 : deux semaines au jour pres, deux mois a la
# semaine, un an au mois, pour une quarantaine d'archives). KEEP=0 garde tout. Puis garde-fou : tant que le
# dossier a moins de MIN_FREE % de place libre, la plus ancienne est supprimee (les 3 plus recentes jamais).
prune_archives() {
    local name day week month count=0 weeks=0 months=0 last_week="" last_month="" old
    local -A kept=()
    if ((keep > 0)); then
        while read -r name; do
            [[ -n $name ]] || continue
            day=${name#"$PREFIX"}
            day=${day:0:10}
            week=$(date -d "$day" +%G-%V 2>/dev/null) || continue
            month=${day:0:7}
            ((count < keep)) && kept[$name]=1
            count=$((count + 1))
            if [[ $week != "$last_week" ]]; then
                last_week=$week
                ((weeks < keep_weekly)) && kept[$name]=1
                weeks=$((weeks + 1))
            fi
            if [[ $month != "$last_month" ]]; then
                last_month=$month
                ((months < keep_monthly)) && kept[$name]=1
                months=$((months + 1))
            fi
        done < <(archives | sort -r)
        while read -r old; do
            [[ -n $old && -z ${kept[$old]:-} ]] || continue
            rm -f -- "$backup_dir/$old"
            log "ancienne archive supprimee : $old"
        done < <(archives)
    fi
    while (($(free_percent) < min_free)) && (($(archives | wc -l) > 3)); do
        old=$(archives | head -n 1)
        rm -f -- "$backup_dir/$old"
        log "place insuffisante (moins de $min_free % libres) : $old supprimee"
    done
}

free_percent() {
    df --output=avail,size "$backup_dir" | awk 'NR == 2 { printf "%d", $1 * 100 / $2 }'
}

list_backups() {
    local name
    echo "Dossier : $backup_dir (garder : $keep + $keep_weekly hebdo + $keep_monthly mensuelles, $min_free % libres," \
        "frequence : $schedule)"
    while read -r name; do
        [[ -n $name ]] || continue
        printf '  %s  %6s\n' "$name" "$(du -h "$backup_dir/$name" | cut -f1)"
    done < <(archives)
}

apply_schedule() {
    [[ -d /run/systemd/system ]] || return 0
    if [[ $schedule == off ]]; then
        rm -rf "$TIMER_DROPIN_DIR"
        systemctl daemon-reload
        systemctl disable --now qrprotec-backup.timer >/dev/null 2>&1 || :
        log "sauvegardes automatiques desactivees"
        return
    fi
    systemd-analyze calendar "$schedule" >/dev/null 2>&1 || die "frequence invalide : $schedule"
    mkdir -p "$TIMER_DROPIN_DIR"
    printf '# Genere par qrprotec-backup --apply-schedule (QRPROTEC_BACKUP_SCHEDULE)\n[Timer]\nOnCalendar=\nOnCalendar=%s\n' \
        "$schedule" >"$TIMER_DROPIN_DIR/schedule.conf"
    chmod 0644 "$TIMER_DROPIN_DIR/schedule.conf"
    systemctl daemon-reload
    systemctl enable --now qrprotec-backup.timer >/dev/null 2>&1 || :
    log "sauvegarde automatique : $schedule (prochaine : $(systemctl show -P NextElapseUSecRealtime qrprotec-backup.timer 2>/dev/null || echo ?))"
}

# Copie un fichier restaure avec proprietaire et droits explicites
put() {
    local source=$1 target=$2 owner=$3 mode=$4
    [[ -f $source ]] || return 0
    install -D -o "${owner%:*}" -g "${owner#*:}" -m "$mode" "$source" "$target"
}

restore_backup() {
    local archive=$1 db_only=$2 assume_yes=$3 work name answer services=() restore_db=no
    [[ -f $archive ]] || die "archive introuvable : $archive"
    archive=$(realpath "$archive")

    work=$(mktemp -d)
    # shellcheck disable=SC2064
    trap "rm -rf '$work'" EXIT
    tar -C "$work" --no-same-owner -xJf "$archive" || die "archive illisible : $archive"
    name=$(find "$work" -mindepth 1 -maxdepth 1 -type d -name "${PREFIX}*" -printf '%f\n' | head -n 1)
    [[ -n $name && -f $work/$name/MANIFEST ]] || die "$archive n'est pas une sauvegarde QRProtec"
    local src=$work/$name
    grep -Eq "^format=(1|$FORMAT)$" "$src/MANIFEST" || die "format d'archive non pris en charge"
    if [[ -f $src/db.sqlite3 ]]; then
        sqlite_check "$src/db.sqlite3" || die "la base de l'archive est invalide"
        if [[ $has_server == yes ]]; then
            restore_db=yes
        else
            echo "La base de l'archive est ignoree : le back (qrprotec-server) n'est pas installe ici."
        fi
    elif [[ $db_only == yes ]]; then
        die "cette archive ne contient pas de base (sauvegarde d'un kiosk seul)"
    fi

    echo "Archive : $archive"
    sed 's/^/  /' "$src/MANIFEST"
    if [[ $db_only == yes ]]; then
        echo "Restauration de la base seulement (configuration actuelle conservee)."
    elif [[ $restore_db == yes ]]; then
        echo "Restauration de la base ET de la configuration (/etc/qrprotec, Caddy, kiosk)."
    else
        echo "Restauration de la configuration (/etc/qrprotec, kiosk), sans base."
    fi
    if [[ $restore_db == yes ]]; then
        echo "La base actuelle sera remplacee (une sauvegarde de l'etat actuel est faite avant)."
    fi
    if [[ $assume_yes != yes ]]; then
        [[ -t 0 ]] || die "confirmation requise : relancer avec --yes"
        read -r -p "Continuer ? [o/N] : " answer
        [[ ${answer,,} =~ ^(o|oui|y|yes)$ ]] || die "abandon"
    fi

    # Filet de securite : etat actuel, sans rotation (ne supprime pas l'archive a restaurer)
    if [[ $has_server == yes && -f $db_path ]] || [[ $has_server == no && $has_kiosk == yes ]]; then
        (create_backup no) || die "sauvegarde de l'etat actuel impossible, restauration annulee"
    fi

    if [[ -d /run/systemd/system ]]; then
        local unit
        for unit in qrprotec-kiosk.service qrprotec-alerts.timer qrprotec.service; do
            if systemctl is-active --quiet "$unit"; then
                services+=("$unit")
                systemctl stop "$unit"
            fi
        done
    fi

    if [[ $restore_db == yes ]]; then
        put "$src/db.sqlite3" "$db_path" qrprotec:qrprotec 0640
        rm -f "$db_path-journal" "$db_path-wal" "$db_path-shm"
        log "base restauree : $db_path"
    fi

    if [[ $db_only != yes ]]; then
        local file
        for file in "$src"/etc/qrprotec/*; do
            [[ -f $file ]] || continue
            # configuration du back ou du kiosk : seulement si cette partie est installee ici
            case ${file##*/} in
                qrprotec.conf | secret_key)
                    if [[ $has_server == yes ]]; then put "$file" "$CONF_DIR/${file##*/}" root:qrprotec 0640; fi ;;
                backup_ssh_key)
                    put "$file" "$CONF_DIR/backup_ssh_key" root:root 0600 ;;
                kiosk.conf)
                    if [[ $has_kiosk == yes ]]; then put "$file" "$CONF_DIR/kiosk.conf" root:root 0644; fi ;;
                front-api.conf)
                    if [[ $has_kiosk == yes ]]; then put "$file" "$CONF_DIR/front-api.conf" root:root 0600; fi ;;
                *) put "$file" "$CONF_DIR/${file##*/}" root:root 0644 ;;
            esac
        done
        if [[ $has_server == yes ]]; then
            put "$src/etc/caddy/Caddyfile.d/qrprotec.caddyfile" "$CADDY_FRAGMENT" root:root 0644
            log "configuration restauree : $CONF_DIR, $CADDY_FRAGMENT"
        else
            log "configuration restauree : $CONF_DIR"
        fi
        if [[ -d $src/kiosk && $has_kiosk == yes ]]; then
            load_settings  # dossier des modeles d'apres le kiosk.conf et l'app.conf restaures
            if [[ -d $src/kiosk/config ]]; then
                mkdir -p "$KIOSK_HOME/.config"
                cp -a "$src/kiosk/config/." "$KIOSK_HOME/.config/qrprotec/"
                chown -R qrprotec-kiosk:qrprotec-kiosk "$KIOSK_HOME/.config"
            fi
            if [[ -d $src/kiosk/templates ]]; then
                mkdir -p "$templates_dir"
                cp -a "$src/kiosk/templates/." "$templates_dir/"
                chown -R qrprotec-kiosk:qrprotec-kiosk "$templates_dir"
            fi
            log "reglages et modeles du kiosk restaures"
        fi
        load_settings
        apply_schedule
    fi

    if command -v restorecon >/dev/null 2>&1; then
        restorecon -R "$db_path" "$CONF_DIR" "$CADDY_FRAGMENT" "$KIOSK_HOME" >/dev/null 2>&1 || :
    fi

    if [[ -d /run/systemd/system ]]; then
        systemctl daemon-reload
        if [[ $has_server == yes ]]; then
            # le back applique les migrations au demarrage (archive d'une version plus ancienne)
            systemctl start qrprotec.service
            systemctl try-reload-or-restart caddy.service || :
        fi
        local unit
        for unit in "${services[@]}"; do
            [[ $unit == qrprotec.service ]] || systemctl start "$unit"
        done
    fi
    log "restauration terminee depuis $archive"
}

action=create rotate=yes no_report=no db_only=no assume_yes=no archive="" dir_override=""
while (($#)); do
    case $1 in
        --list) action=list ;;
        --restore) action=restore; archive=${2:?archive .tar.xz attendue}; shift ;;
        --apply-schedule) action=schedule ;;
        --sync) action=sync ;;
        --db-only) db_only=yes ;;
        --no-rotate) rotate=no ;;
        --no-report) no_report=yes ;;  # essai a la main : pas de notification des admins
        --dir) dir_override=${2:?}; shift ;;
        -y | --yes) assume_yes=yes ;;
        -h | --help) usage; exit 0 ;;
        *) usage >&2; exit 2 ;;
    esac
    shift
done

[[ $(id -u) -eq 0 ]] || die "a lancer en root (sudo qrprotec-backup)"
load_settings
[[ -n $dir_override ]] && backup_dir=$dir_override

case $action in
    create)
        status=0
        run_step backup create_backup "$rotate" || status=$?
        # envoi meme si l'archive du jour a echoue : les precedentes partent quand meme
        if [[ -n $sync_target ]]; then
            run_step sync sync_backups || status=$?
        fi
        exit "$status"
        ;;
    sync)
        [[ -n $sync_target ]] || die "pas de machine distante (QRPROTEC_BACKUP_SYNC_TARGET) : sudo qrprotec-setup --backup-sync"
        run_step sync sync_backups
        ;;
    list) list_backups ;;
    restore) restore_backup "$archive" "$db_only" "$assume_yes" ;;
    schedule) apply_schedule ;;
esac
