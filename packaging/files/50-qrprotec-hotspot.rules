// Le kiosk QRProtec (utilisateur qrprotec-kiosk) peut lancer et arreter le wifi de secours de la borne
// (qrprotec-hotspot.service, menu TECH du poste), et rien d'autre parmi les services du systeme.
polkit.addRule(function (action, subject) {
    if (action.id == "org.freedesktop.systemd1.manage-units" &&
        subject.user == "qrprotec-kiosk" &&
        action.lookup("unit") == "qrprotec-hotspot.service") {
        var verb = action.lookup("verb");
        if (verb == "start" || verb == "stop" || verb == "restart") {
            return polkit.Result.YES;
        }
    }
});
