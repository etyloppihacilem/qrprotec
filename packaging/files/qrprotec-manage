#!/usr/bin/bash
# Lance `manage.py` du back QRProtec avec la configuration de /etc/qrprotec.
#
#   sudo qrprotec-manage createadmin M001 Nom Prenom --pin 4821
#   sudo qrprotec-manage check_alerts
#   sudo qrprotec-manage maintenance on|off|status [MESSAGE]
#
# `maintenance` ne passe pas par Django (le back peut etre arrete) : Caddy sert une page de maintenance a la
# place de tout le site tant que /etc/qrprotec/maintenance/index.html existe (voir qrprotec.caddyfile).
#
# Lance par root, charge la configuration et la cle secrete puis repasse sous l'utilisateur
# `qrprotec` (proprietaire de la base). Sous systemd (qrprotec.service), la configuration vient
# d'EnvironmentFile=. La cle secrete est lue dans /etc/qrprotec/secret_key (0640 root:qrprotec).
set -euo pipefail

readonly APP_DIR=@APPDIR@
readonly CONF_FILE=/etc/qrprotec/qrprotec.conf
readonly SECRET_FILE=/etc/qrprotec/secret_key
readonly SERVICE_USER=qrprotec
readonly STATE_DIR=/var/lib/qrprotec
readonly MAINTENANCE_DIR=/etc/qrprotec/maintenance
readonly MAINTENANCE_PAGE=$MAINTENANCE_DIR/index.html
readonly MAINTENANCE_BYPASS_DIR=$MAINTENANCE_DIR/bypass
readonly MAINTENANCE_TEMPLATE=$APP_DIR/maintenance.html
readonly CADDY_FRAGMENT=/etc/caddy/Caddyfile.d/qrprotec.caddyfile

maintenance_usage() {
    cat <<'USAGE'
Usage : sudo qrprotec-manage maintenance on [--code[=CODE]] [MESSAGE]   page de maintenance a la place du site
        sudo qrprotec-manage maintenance off                             site de nouveau accessible
        qrprotec-manage maintenance status                               etat actuel

Pendant la maintenance, Caddy repond 503 a tout le site (pages, API, WebSockets, fronts distants) sans
joindre le back, qui peut etre arrete. L'API locale du poste (127.0.0.1:8001) ne passe pas par Caddy et reste
accessible. MESSAGE (facultatif) s'ajoute a la page, ex. :
    sudo qrprotec-manage maintenance on "Retour prevu vers 14 h."

--code : code de contournement pour tester le web pendant la maintenance (demande au clavier, ou --code=CODE,
6 caracteres au moins). Sur la page, 5 appuis rapides sur le logo « QRprotec » ouvrent sa saisie ; le navigateur
qui l'a donne voit le vrai site pendant 12 h. Sans --code, pas de contournement ; relancer « on » sans --code
le desactive.
USAGE
}

# Code de contournement lu au clavier, deux fois, sans echo
maintenance_read_code() {
    local first second
    read -rsp "Code de contournement : " first </dev/tty && echo >&2
    read -rsp "Confirmez le code : " second </dev/tty && echo >&2
    if [[ $first != "$second" ]]; then
        echo "qrprotec-manage : les deux codes different." >&2
        exit 1
    fi
    printf '%s' "$first"
}

# Avertit si le fragment Caddy installe ne connait pas encore le mode maintenance (fragment modifie a la main,
# nouvelle version laissee en .rpmnew par la mise a jour) : la page ne serait alors jamais servie.
maintenance_check_caddy() {
    if [[ -r $CADDY_FRAGMENT ]] && ! grep -q "$MAINTENANCE_DIR" "$CADDY_FRAGMENT"; then
        echo "ATTENTION : $CADDY_FRAGMENT ne gere pas le mode maintenance (fichier modifie localement ?)." >&2
        echo "            Reportez le bloc @maintenance de $CADDY_FRAGMENT.rpmnew, puis : sudo systemctl reload caddy" >&2
    fi
}

maintenance() {
    local action=${1:-status}
    case $action in
        on | off)
            if [[ $(id -u) -ne 0 ]]; then
                echo "qrprotec-manage maintenance $action : a lancer en root (sudo)." >&2
                exit 1
            fi
            ;;
        status) ;;
        -h | --help | help) maintenance_usage; return 0 ;;
        *) maintenance_usage >&2; exit 2 ;;
    esac

    case $action in
        on)
            shift
            local code='' want_code=no args=()
            while (($#)); do
                case $1 in
                    --code) want_code=yes ;;
                    --code=*) want_code=yes; code=${1#--code=} ;;
                    --) shift; args+=("$@"); break ;;
                    -*) maintenance_usage >&2; exit 2 ;;
                    *) args+=("$1") ;;
                esac
                shift
            done
            if [[ $want_code == yes && -z $code ]]; then
                code=$(maintenance_read_code)
            fi
            code=$(printf '%s' "$code" | sed -e 's/^[[:space:]]*//' -e 's/[[:space:]]*$//')
            if [[ $want_code == yes && ${#code} -lt 6 ]]; then
                echo "qrprotec-manage : code trop court (6 caracteres au moins, plus long = plus sur)." >&2
                exit 1
            fi
            local message=${args[*]:-} html='' tmp salt=''
            if [[ ! -r $MAINTENANCE_TEMPLATE ]]; then
                echo "qrprotec-manage : modele $MAINTENANCE_TEMPLATE introuvable (qrprotec-server installe ?)" >&2
                exit 1
            fi
            if [[ -n $message ]]; then
                # Remplacements entre guillemets : sinon bash >= 5.2 (patsub_replacement) lit « & » comme le motif
                message=${message//'&'/'&amp;'}
                message=${message//'<'/'&lt;'}
                message=${message//'>'/'&gt;'}
                message=${message//'"'/'&quot;'}
                html="<p><strong>${message}</strong></p>"
            fi
            local already=no
            [[ -e $MAINTENANCE_PAGE ]] && already=yes
            install -d -m 0755 "$MAINTENANCE_DIR"
            # Contournement : seul le hachage SHA-256(sel:code) est garde, comme nom de fichier ; dossier 0711 (Caddy
            # teste un nom precis, personne ne liste les hachages, qui valent le cookie). Nouveau sel a chaque « on ».
            rm -rf "$MAINTENANCE_BYPASS_DIR"
            if [[ -n $code ]]; then
                salt=$(od -An -N16 -tx1 /dev/urandom | tr -d ' \n')
                install -d -m 0711 "$MAINTENANCE_BYPASS_DIR"
                : >"$MAINTENANCE_BYPASS_DIR/$(printf '%s' "$salt:$code" | sha256sum | cut -d' ' -f1).ok"
            fi
            tmp=$(mktemp "$MAINTENANCE_DIR/.index.XXXXXX")
            local line
            while IFS= read -r line || [[ -n $line ]]; do
                line=${line//@SALT@/"$salt"}
                printf '%s\n' "${line//@MESSAGE@/"$html"}"
            done <"$MAINTENANCE_TEMPLATE" >"$tmp"
            chmod 0644 "$tmp"
            mv -f "$tmp" "$MAINTENANCE_PAGE"
            if [[ $already == yes ]]; then
                echo "Maintenance deja activee : page mise a jour."
            else
                # Le fichier suffit pour les nouvelles requetes ; recharger Caddy coupe aussi les WebSockets deja
                # ouverts (suivi en direct, telephones-douchettes), qui se reconnectent sur la page de maintenance.
                systemctl reload caddy.service 2>/dev/null || :
                echo "Maintenance activee : le site affiche « Maintenance en cours, QRprotec n'est pas accessible pour le moment. »"
            fi
            if [[ -n $code ]]; then
                echo "Contournement par code active : 5 appuis sur le logo de la page, puis le code."
            else
                echo "Contournement desactive (sudo qrprotec-manage maintenance on --code pour en definir un)."
            fi
            echo "Le back peut etre arrete sans erreur visible (sudo systemctl stop qrprotec). Fin : sudo qrprotec-manage maintenance off"
            maintenance_check_caddy
            ;;
        off)
            if [[ -e $MAINTENANCE_PAGE ]]; then
                rm -f "$MAINTENANCE_PAGE"
                rm -rf "$MAINTENANCE_BYPASS_DIR"
                echo "Maintenance terminee : le site est de nouveau accessible."
            else
                echo "Maintenance deja desactivee."
            fi
            if ! systemctl is-active --quiet qrprotec.service 2>/dev/null; then
                echo "ATTENTION : le back (qrprotec.service) est arrete ; relancez-le : sudo systemctl start qrprotec" >&2
            fi
            ;;
        status)
            if [[ -e $MAINTENANCE_PAGE ]]; then
                echo "Maintenance : activee depuis le $(date -r "$MAINTENANCE_PAGE" '+%d/%m/%Y a %H:%M')"
                if [[ -d $MAINTENANCE_BYPASS_DIR ]]; then
                    echo "Contournement par code : active (5 appuis sur le logo de la page)"
                else
                    echo "Contournement par code : desactive"
                fi
            else
                echo "Maintenance : desactivee"
            fi
            local service
            for service in caddy qrprotec; do
                echo "$service.service : $(systemctl is-active "$service.service" 2>/dev/null || :)"
            done
            maintenance_check_caddy
            ;;
    esac
}

if [[ ${1:-} == maintenance ]]; then
    shift
    maintenance "$@"
    exit 0
fi

if [[ -z ${INVOCATION_ID:-} && -r $CONF_FILE ]]; then
    set -a
    # shellcheck source=/dev/null
    . "$CONF_FILE"
    set +a
fi

if [[ -z ${QRPROTEC_SECRET_KEY:-} && -r $SECRET_FILE ]]; then
    QRPROTEC_SECRET_KEY=$(<"$SECRET_FILE")
fi
if [[ -z ${QRPROTEC_SECRET_KEY:-} ]]; then
    if [[ -e $SECRET_FILE && ! -r $SECRET_FILE ]]; then
        echo "qrprotec-manage : $SECRET_FILE n'est lisible que par root et qrprotec. Lancez : sudo qrprotec-manage ${*:-help}" >&2
    else
        echo "qrprotec-manage : cle secrete introuvable ($SECRET_FILE). Lancez : sudo qrprotec-setup" >&2
    fi
    exit 1
fi
export QRPROTEC_SECRET_KEY

if [[ $(id -u) -eq 0 ]]; then
    # INVOCATION_ID evite de relire la configuration apres le changement d'utilisateur
    exec runuser -u "$SERVICE_USER" -- env INVOCATION_ID="${INVOCATION_ID:-cli}" "$0" "$@"
fi

# Une seule source pour le nom d'hote : QRPROTEC_DOMAIN
domain=${QRPROTEC_DOMAIN:-localhost}
export QRPROTEC_PUBLIC_BASE_URL="${QRPROTEC_PUBLIC_BASE_URL:-https://${domain}/}"
export QRPROTEC_ALLOWED_HOSTS="${QRPROTEC_ALLOWED_HOSTS:-${domain},localhost,127.0.0.1,[::1]}"
export QRPROTEC_DEBUG="${QRPROTEC_DEBUG:-0}"
export QRPROTEC_DB_PATH="${QRPROTEC_DB_PATH:-$STATE_DIR/db.sqlite3}"
export DJANGO_SETTINGS_MODULE=qrprotecDB.settings
export PYTHONPATH="$APP_DIR/backend:$APP_DIR/vendor"
export PYTHONDONTWRITEBYTECODE=1

cd "$STATE_DIR" 2>/dev/null || cd /
exec /usr/bin/python3 -s "$APP_DIR/backend/manage.py" "$@"
