# QRProtec : reverse proxy HTTPS vers l'API publique du back (127.0.0.1:8000) et, pour les fronts
# d'autres machines (requetes avec l'en-tete X-QRProtec-Key), vers l'API distante (127.0.0.1:8002).
#
# Le nom d'hote (QRPROTEC_DOMAIN) et le mode TLS (QRPROTEC_TLS) se reglent dans
# /etc/qrprotec/qrprotec.conf (ou avec `sudo qrprotec-setup`), charge dans l'environnement de Caddy
# par /usr/lib/systemd/system/caddy.service.d/qrprotec.conf.
#
# L'API locale (127.0.0.1:8001, gestion sans cle) n'est volontairement PAS exposee : elle ne sert
# qu'au front de la meme machine. L'API distante offre les memes routes mais refuse toute requete
# sans cle de front valide (sudo qrprotec-manage frontkey add NOM) : sans cle creee, elle ne sert a rien.

# Port 80 : redirection vers HTTPS (le defi ACME HTTP-01 reste gere par Caddy)
http://{$QRPROTEC_DOMAIN:localhost} {
	redir https://{host}{uri} permanent
}

https://{$QRPROTEC_DOMAIN:localhost} {
	# "internal" : certificat de l'autorite locale de Caddy (reseau local, adresse IP) ;
	# une adresse e-mail : certificat Let's Encrypt / ZeroSSL (nom de domaine public).
	tls {$QRPROTEC_TLS:internal}

	encode zstd gzip

	# Le back gere aussi les WebSockets du telephone-douchette (/ws/scanner/...) :
	# reverse_proxy transmet l'upgrade et ajoute X-Forwarded-Proto / X-Forwarded-For.
	# Certificat racine de l'autorite locale (tls internal) : les telephones l'installent pour faire
	# confiance au site, sans quoi Chrome et Safari refusent d'installer l'appli (voir la doc
	# d'installation). Seul root.crt est servi, jamais la cle ; absent avec Let's Encrypt (404).
	handle /qrprotec-ca.crt {
		root * /var/lib/caddy/.local/share/caddy/pki/authorities/local
		rewrite * /root.crt
		header Content-Type application/x-x509-ca-cert
		header Cache-Control no-cache
		file_server
	}

	@front header X-QRProtec-Key *
	handle @front {
		reverse_proxy 127.0.0.1:{$QRPROTEC_REMOTE_API_PORT:8002}
	}
	handle {
		reverse_proxy 127.0.0.1:{$QRPROTEC_PUBLIC_API_PORT:8000}
	}

	header -Server
}
