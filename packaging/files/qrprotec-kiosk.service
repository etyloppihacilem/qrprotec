[Unit]
Description=QRProtec kiosk (front plein ecran dans Cage sur tty1)
Documentation=file:///usr/share/doc/qrprotec/README.md
After=systemd-user-sessions.service plymouth-quit-wait.service getty@tty1.service
After=qrprotec.service caddy.service
Wants=qrprotec.service caddy.service
# Le kiosk prend tty1 a la place de l'invite de connexion (comme un gestionnaire d'affichage)
Conflicts=getty@tty1.service
ConditionPathExists=/dev/tty1
StartLimitIntervalSec=0

[Service]
Type=simple
User=qrprotec-kiosk
PAMName=login
TTYPath=/dev/tty1
TTYReset=yes
TTYVHangup=yes
TTYVTDisallocate=yes
StandardInput=tty
StandardOutput=journal
StandardError=journal
UtmpIdentifier=tty1
UtmpMode=user
Environment=XDG_SESSION_TYPE=wayland XDG_SESSION_CLASS=user
# Disposition du clavier, mise en veille de l'ecran... (voir ce fichier)
EnvironmentFile=-/etc/qrprotec/kiosk.conf
# -s : autorise Ctrl+Alt+F2... pour atteindre une console de maintenance
ExecStart=/usr/bin/cage -s -- /usr/libexec/qrprotec/qrprotec-kiosk-session
Restart=always
RestartSec=2

[Install]
WantedBy=graphical.target
