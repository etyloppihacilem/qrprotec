{
  "version": 2,
  "name": "Lot public",
  "category": "lot_public",
  "media": {"width_mm": 40, "height_mm": 30, "pixels_per_mm": 8, "orientation": "landscape"},
  "label_type": {"name": "40 x 30 mm", "width_mm": 40, "height_mm": 30, "rotation": 0, "support": "direct", "margin_top_mm": 1, "margin_bottom_mm": 2, "margin_left_mm": 1, "margin_right_mm": 1},
  "parameters": {"lot_name": "Sac O2 ALPHA", "lot_parent_name": "Lot B+ Alpha", "lot_type_name": "Sac O2", "lot_url": "https://example.com/verif?lot=sacpse00000001", "titre": "PROTECTION CIVILE\nPARIS CENTRE"},
  "elements": [
    {"id": "logo", "kind": "image", "path": "images/protection-civile.png", "x_mm": 1, "y_mm": 1, "width_mm": 16.5, "height_mm": 7, "dither": 0, "threshold": 128},
    {"id": "qr", "kind": "qr", "payload": "{{lot_url}}", "x_mm": 17.5, "y_mm": 1, "size_mm": 21.5, "ecc": 0, "quiet_zone": 0},
    {"id": "nom", "kind": "text", "text": "{{lot_name}}", "x_mm": 1, "y_mm": 22, "width_mm": 38, "height_mm": 4, "font_size_mm": 3, "bold": 1, "align": "left"},
    {"id": "parent", "kind": "text", "text": "{{lot_parent_name}}", "x_mm": 1, "y_mm": 12, "width_mm": 16.5, "height_mm": 4.5, "font_size_mm": 1.6, "bold": 0, "align": "left"},
    {"id": "nom-antenne", "kind": "text", "text": "{{titre}}", "x_mm": 1, "y_mm": 8.5, "width_mm": 16.5, "height_mm": 3.5, "font_size_mm": 1.4, "bold": 1, "align": "center"},
    {"id": "texte", "kind": "text", "text": "Scanner pour avoir les infos sur la vérif", "x_mm": 1, "y_mm": 25.5, "width_mm": 38, "height_mm": 2.5, "font_size_mm": 1.9, "bold": 0, "align": "left"},
    {"id": "type-2", "kind": "text", "text": "{{lot_type_name}}", "x_mm": 1, "y_mm": 16.5, "width_mm": 16.5, "height_mm": 4.5, "font_size_mm": 1.6, "bold": 0, "align": "right"}
  ]
}
