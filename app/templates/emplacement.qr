{
  "version": 2,
  "name": "Emplacement",
  "category": "lot_location",
  "media": {"width_mm": 40, "height_mm": 30, "pixels_per_mm": 8, "orientation": "landscape"},
  "label_type": {"name": "40 x 30 mm", "width_mm": 40, "height_mm": 30, "rotation": 0, "support": "direct", "margin_top_mm": 0, "margin_bottom_mm": 2, "margin_left_mm": 1, "margin_right_mm": 0},
  "parameters": {"emplacement": "Pochette rouge", "lot_type_name": "Sac de soin", "titre": "PROTECTION CIVILE\nPARIS CENTRE"},
  "elements": [
    {"id": "type", "kind": "text", "text": "{{lot_type_name}}", "x_mm": 1, "y_mm": 0, "width_mm": 39, "height_mm": 5, "font_size_mm": 2.2, "bold": 0, "align": "center"},
    {"id": "emplacement", "kind": "text", "text": "{{emplacement}}", "x_mm": 1, "y_mm": 5, "width_mm": 39, "height_mm": 18.5, "font_size_mm": 4, "bold": 1, "align": "center"},
    {"id": "nom-antenne", "kind": "text", "text": "{{titre}}", "x_mm": 5, "y_mm": 24, "width_mm": 35, "height_mm": 4, "font_size_mm": 1.6, "bold": 1, "align": "center"},
    {"id": "image", "kind": "image", "path": "images/protection-civile.png", "x_mm": 9.5, "y_mm": 23.5, "width_mm": 4, "height_mm": 4.5, "dither": 0, "threshold": 128}
  ]
}
