{
  "version": 2,
  "name": "Scellé de lot",
  "category": "lot_seal",
  "media": {
    "width_mm": 40,
    "height_mm": 30,
    "pixels_per_mm": 8,
    "orientation": "landscape"
  },
  "parameters": {},
  "elements": [
    {
      "id": "qr",
      "kind": "qr",
      "payload": "{{seal_url}}",
      "x_mm": 1,
      "y_mm": 2,
      "size_mm": 24
    },
    {
      "id": "titre",
      "kind": "text",
      "text": "SCELLÉ",
      "x_mm": 26,
      "y_mm": 2,
      "width_mm": 13,
      "height_mm": 5,
      "font_size_mm": 2.8
    },
    {
      "id": "numero",
      "kind": "text",
      "text": "{{seal_number}}",
      "x_mm": 26,
      "y_mm": 8,
      "width_mm": 13,
      "height_mm": 4,
      "font_size_mm": 2.2
    },
    {
      "id": "nom",
      "kind": "text",
      "text": "{{lot_short}}",
      "x_mm": 26,
      "y_mm": 14,
      "width_mm": 13,
      "height_mm": 6,
      "font_size_mm": 2.6
    },
    {
      "id": "exp",
      "kind": "text",
      "text": "Valide jusqu'au {{valid_until}}",
      "x_mm": 1,
      "y_mm": 26,
      "width_mm": 38,
      "height_mm": 4,
      "font_size_mm": 1.8
    }
  ]
}
