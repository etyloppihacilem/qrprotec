    {"id": "exp", "kind": "text", "text": "{[Exp. ]{peremption}}", "x_mm": 38, "y_mm": 15.5, "width_mm": 12.5, "height_mm": 2, "font_size_mm": 1.4, "bold": 0, "align": "left", "rotation": 270},
    {"id": "tasks", "kind": "text", "text": "{{tasks}}", "x_mm": 1, "y_mm": 18.5, "width_mm": 37, "height_mm": 9.5, "font_size_mm": 2, "bold": 0, "align": "left"},
