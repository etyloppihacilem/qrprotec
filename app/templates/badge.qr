{
  "version": 2,
  "name": "Badge",
  "category": "user",
  "media": {
    "width_mm": 40,
    "height_mm": 30,
    "pixels_per_mm": 8,
    "orientation": "landscape"
  },
  "parameters": {},
  "elements": [
    {
      "id": "logo",
      "kind": "image",
      "path": "logo.png",
      "x_mm": 1,
      "y_mm": 1,
      "width_mm": 9,
      "height_mm": 9,
      "dither": 1,
      "threshold": 128
    },
    {
      "id": "qr",
      "kind": "qr",
      "payload": "{{badge_url}}",
      "x_mm": 18,
      "y_mm": 2,
      "size_mm": 21
    },
    {
      "id": "nom",
      "kind": "text",
      "text": "{{full_name}}",
      "x_mm": 1,
      "y_mm": 11,
      "width_mm": 17,
      "height_mm": 8,
      "font_size_mm": 2.6
    },
    {
      "id": "role",
      "kind": "text",
      "text": "{{role}} {{matricule}}",
      "x_mm": 1,
      "y_mm": 20,
      "width_mm": 17,
      "height_mm": 4,
      "font_size_mm": 2.0
    },
    {
      "id": "exp",
      "kind": "text",
      "text": "Valide jusqu'au {{key_expires}}",
      "x_mm": 1,
      "y_mm": 25,
      "width_mm": 38,
      "height_mm": 4,
      "font_size_mm": 1.8
    }
  ]
}
