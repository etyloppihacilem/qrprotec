{
  "version": 2,
  "name": "Badge",
  "category": "user",
  "media": {"width_mm": 40, "height_mm": 30, "pixels_per_mm": 8, "orientation": "landscape"},
  "parameters": {"badge_url": "https://example.com/badge?m=M0042&key=a1B2c3D4e5F6g7H8", "code": "code", "code{{titre": "code{{titre", "code}{{titre": "code}{{titre", "cod{{titre": "cod{{titre", "co{{titre": "co{{titre", "c{{titre": "c{{titre", "fonction": "Secouriste", "full_name": "Jean-François Bateauroux", "key_expires": "29/09/2027", "matricule": "1234567", "role": "Secouriste", "titre": "PROTECTION CIVILE\nPARIS CENTRE", "{titre": "{titre", "{{titre": "{{titre"},
  "elements": [
    {"id": "logo", "kind": "image", "path": "images/protection-civile.png", "x_mm": 1, "y_mm": 1, "width_mm": 17, "height_mm": 13, "dither": 0, "threshold": 129},
    {"id": "qr", "kind": "qr", "payload": "{{badge_url}}", "x_mm": 18.5, "y_mm": 1, "size_mm": 17.5, "ecc": 1, "quiet_zone": 0},
    {"id": "nom", "kind": "text", "text": "{{full_name}}", "x_mm": 0.5, "y_mm": 19.5, "width_mm": 36, "height_mm": 7.5, "font_size_mm": 3.1, "bold": 1, "align": "left"},
    {"id": "role", "kind": "text", "text": "{{fonction}}", "x_mm": 0.5, "y_mm": 24, "width_mm": 34, "height_mm": 3, "font_size_mm": 2.3, "bold": 0, "align": "right"},
    {"id": "exp", "kind": "text", "text": "Valable jusqu'au {{key_expires}}", "x_mm": 36.5, "y_mm": 1, "width_mm": 28, "height_mm": 2.4, "font_size_mm": 1.8, "bold": 0, "align": "left", "rotation": 270},
    {"id": "texte-5", "kind": "text", "text": "{{titre}}", "x_mm": 0.5, "y_mm": 14.5, "width_mm": 18, "height_mm": 4, "font_size_mm": 1.6, "bold": 1, "align": "center"},
    {"id": "Objet trouvé", "kind": "text", "text": "Badge d'accès QRProtec", "x_mm": 0.5, "y_mm": 27, "width_mm": 19.5, "height_mm": 2, "font_size_mm": 1.5, "bold": 0, "align": "left"},
    {"id": "role-2", "kind": "text", "text": "{{matricule}}", "x_mm": 28.5, "y_mm": 27.5, "width_mm": 8, "height_mm": 1.5, "font_size_mm": 1.3, "bold": 0, "align": "right"}
  ]
}
